<?xml version="1.0" encoding="UTF-8"?>
<!--
  Relaxed structural schema for Business Vault .hbv files (AI guidance).
  Source of truth: org.apache.hop.datavault.metadata.businessvault.BusinessVaultModel
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="hopYn">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Y"/>
      <xs:enumeration value="N"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="openElements">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="business-vault-model">
    <xs:annotation>
      <xs:documentation>
        Business Vault model (.hbv). Requires dataVaultModelPath to parent .hdv.
        Table types include SCD2, PIT, BUSINESS_TABLE.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="name" type="xs:string" minOccurs="0"/>
        <xs:element name="name_sync_with_filename" type="hopYn" minOccurs="0"/>
        <xs:element name="description" type="xs:string" minOccurs="0"/>
        <xs:element name="dataVaultModelPath" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Path to parent raw Data Vault .hdv (use ${PROJECT_HOME}/…).</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="configuration" type="openElements" minOccurs="0"/>
        <xs:element name="coaching" type="openElements" minOccurs="0"/>
        <xs:element name="tables" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="table" type="openElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>

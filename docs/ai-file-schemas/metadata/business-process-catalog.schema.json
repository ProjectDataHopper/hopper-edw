{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ProjectDataHopper/hopper-edw/docs/ai-file-schemas/metadata/business-process-catalog.schema.json",
  "title": "Business process catalog",
  "description": "metadata/business-process-catalog/*.json",
  "type": "object",
  "required": ["name"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "virtualPath": { "type": "string" },
    "domain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "parentName": { "type": "string" }
        }
      }
    },
    "level1": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "level2": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "level3": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}

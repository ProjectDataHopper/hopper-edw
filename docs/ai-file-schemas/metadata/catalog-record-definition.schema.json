{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mattcasters/hop-data-vault/docs/ai-file-schemas/metadata/catalog-record-definition.schema.json",
  "title": "Catalog record definition (DV_SOURCE etc.)",
  "description": "Catalog FILE store JSON for sources/targets. Models reference these by name.",
  "type": "object",
  "required": ["name", "type"],
  "additionalProperties": true,
  "properties": {
    "namespace": { "type": "string" },
    "name": {
      "type": "string",
      "description": "Logical name used as recordSource in .hdv (e.g. CRM-customer)."
    },
    "type": {
      "type": "string",
      "description": "Record type code, e.g. DV_SOURCE."
    },
    "description": { "type": "string" },
    "rowMetaXml": {
      "type": "string",
      "description": "Embedded Hop row-meta XML (often large)."
    },
    "origin": { "type": "object", "additionalProperties": true },
    "physicalTable": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "databaseMetaName": { "type": "string" },
        "schemaName": { "type": "string" },
        "tableName": { "type": "string" }
      }
    },
    "physicalFile": { "type": "object", "additionalProperties": true },
    "tags": { "type": "array", "items": { "type": "string" } },
    "glossaryTerms": { "type": "array" },
    "customProperties": { "type": "object" },
    "dvSource": {
      "type": "object",
      "additionalProperties": true,
      "description": "DV-specific source binding.",
      "properties": {
        "sourceType": { "type": "string", "description": "DATABASE, CSV, COMPOSITE, …" },
        "sourceIndicator": { "type": "string" },
        "sourceIndicatorField": { "type": "string" },
        "group": { "type": ["string", "null"] },
        "deliveryType": { "type": "string", "description": "FULL_SNAPSHOT, …" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "sourceDataType": { "type": "string" },
              "length": { "type": "string" },
              "precision": { "type": "string" },
              "hopType": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mattcasters/hop-data-vault/docs/ai-file-schemas/metadata/data-quality-rule-set.schema.json",
  "title": "Data quality rule set",
  "description": "metadata/data-quality-rule-set/*.json",
  "type": "object",
  "required": ["name"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "virtualPath": { "type": "string" },
    "rule": {
      "type": "array",
      "description": "List of rules (Hop key is singular 'rule').",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "type": {
            "type": "string",
            "description": "NOT_NULL, ALLOWED_VALUES, MIN_ROW_COUNT, REGEX, SQL_ASSERTION, …"
          },
          "severity": { "type": "string", "description": "BLOCKING, WARNING, …" },
          "fieldName": { "type": "string" },
          "enabled": { "type": "boolean" },
          "evaluationHint": { "type": "string" },
          "parameters": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}

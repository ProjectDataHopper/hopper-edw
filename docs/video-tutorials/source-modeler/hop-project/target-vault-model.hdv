<data-vault-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <configuration>
    <targetDatabase>Vault</targetDatabase>
    <dataCatalogConnection>local-catalog</dataCatalogConnection>
    <hashAlgorithm>MD5</hashAlgorithm>
    <hashKeyDataType>HEX</hashKeyDataType>
    <generateUnknownRecord>Y</generateUnknownRecord>
    <unknownBusinessKeyValue/>
    <unknownHashKeyValue>00000000000000000000000000000000</unknownHashKeyValue>
    <unknownLinkHashKeyValue>00000000000000000000000000000000</unknownLinkHashKeyValue>
    <unknownRecordSource>UNKNOWN</unknownRecordSource>
    <generateInvalidRecord>Y</generateInvalidRecord>
    <invalidBusinessKeyValue/>
    <invalidHashKeyValue>FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF</invalidHashKeyValue>
    <invalidLinkHashKeyValue>FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF</invalidLinkHashKeyValue>
    <invalidRecordSource>INVALID</invalidRecordSource>
    <hashContentCasing>UPPER</hashContentCasing>
    <businessKeyDelimiter>||</businessKeyDelimiter>
    <hashContentPrefix/>
    <nullPlaceholder>^^</nullPlaceholder>
    <hashContentSuffix/>
    <trimBusinessKeys>Y</trimBusinessKeys>
    <hashUsesComposedBusinessKey>N</hashUsesComposedBusinessKey>
    <loadDateField>LOAD_DATE</loadDateField>
    <loadEndDateField>LOAD_END_DATE</loadEndDateField>
    <recordSourceField>RECORD_SOURCE</recordSourceField>
    <recordSourceFieldLength>100</recordSourceFieldLength>
    <storeLoadCycleId>N</storeLoadCycleId>
    <loadCycleIdField>LOAD_CYCLE_ID</loadCycleIdField>
    <loadCycleControlTable>dv_load_cycle</loadCycleControlTable>
    <useLoadEndDate>N</useLoadEndDate>
    <generatePrimaryKeys>N</generatePrimaryKeys>
    <generateForeignKeys>N</generateForeignKeys>
    <targetTableBatchSize>1000</targetTableBatchSize>
    <targetTableParallelCopies>1</targetTableParallelCopies>
    <target_load_mode>Table Output</target_load_mode>
    <bulkLoadStagingFolder>${java.io.tmpdir}/dv2/bulk/</bulkLoadStagingFolder>
    <bulkLoadDelimiter>,</bulkLoadDelimiter>
    <bulkLoadEnclosure>"</bulkLoadEnclosure>
    <bulkLoadEncoding>UTF-8</bulkLoadEncoding>
    <bulkLoadLocalFileRequired>Y</bulkLoadLocalFileRequired>
    <sortRowsSize>1000000</sortRowsSize>
    <execution_log_level>Basic</execution_log_level>
    <singleStoreShardKeyOnHashKey>N</singleStoreShardKeyOnHashKey>
    <singleStoreShardKeyIncludeDrivingKeys>Y</singleStoreShardKeyIncludeDrivingKeys>
    <generatedPipelineFolder/>
    <hubPipelineNamePrefix>hub-</hubPipelineNamePrefix>
    <linkPipelineNamePrefix>link-</linkPipelineNamePrefix>
    <satellitePipelineNamePrefix>sat-</satellitePipelineNamePrefix>
    <generatedWorkflowNamePrefix>DV Bulk Update - </generatedWorkflowNamePrefix>
    <stsPipelineNamePrefix>sts-</stsPipelineNamePrefix>
  </configuration>
  <coaching>
    <coaching_sources>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>customer_address</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>customer_contact</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>customer_demo</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>customer_hub</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>customer_prefs</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>order_header</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>order_line</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>order_rep</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>order_shipment_event</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>product</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>sales_rep</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>shipment_events</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>warehouse</recordName>
        <derived>N</derived>
      </coaching_source>
      <coaching_source>
        <sourceType>RECORD_DEFINITION</sourceType>
        <catalogConnection>local-catalog</catalogConnection>
        <recordNamespace>hop/hop-project/sources</recordNamespace>
        <recordName>warehouse_product</recordName>
        <derived>N</derived>
      </coaching_source>
    </coaching_sources>
  </coaching>
  <tables>
    <table>
      <businessKeys>
        <name>customer_id</name>
        <description/>
        <dataType>Integer</dataType>
        <length>10</length>
        <composite>N</composite>
        <sourceFieldNames/>
        <sourceFieldName>customer_id</sourceFieldName>
        <recordSourceName>customer_hub</recordSourceName>
      </businessKeys>
      <businessKeys>
        <name>customer_id</name>
        <description/>
        <dataType>Integer</dataType>
        <length>10</length>
        <composite>N</composite>
        <sourceFieldNames/>
        <sourceFieldName>customer_id</sourceFieldName>
        <recordSourceName>customer_address</recordSourceName>
      </businessKeys>
      <businessKeys>
        <name>customer_id</name>
        <description/>
        <dataType>Integer</dataType>
        <length>10</length>
        <composite>N</composite>
        <sourceFieldNames/>
        <sourceFieldName>customer_id</sourceFieldName>
        <recordSourceName>customer_contact</recordSourceName>
      </businessKeys>
      <hashKeyFieldName>customer_hk</hashKeyFieldName>
      <recordSourceFieldName/>
      <recordSources>
        <recordSource>customer_hub</recordSource>
        <recordSource>customer_address</recordSource>
        <recordSource>customer_contact</recordSource>
      </recordSources>
      <tableName>h_customer</tableName>
      <description/>
      <tableType>HUB</tableType>
      <integrationMode>HOP_MANAGED</integrationMode>
      <customUpdatePipelinePaths/>
      <xloc>192</xloc>
      <yloc>160</yloc>
      <name>h_customer</name>
      <virtualPath/>
    </table>
    <table>
      <hub>h_customer</hub>
      <link/>
      <attributes>
        <name>address_line1</name>
        <description/>
        <dataType>String</dataType>
        <length>50</length>
        <precision/>
        <includeInChangeDataCapture>Y</includeInChangeDataCapture>
      </attributes>
      <attributes>
        <name>city</name>
        <description/>
        <dataType>String</dataType>
        <length>50</length>
        <precision/>
        <includeInChangeDataCapture>Y</includeInChangeDataCapture>
      </attributes>
      <attributes>
        <name>postal_code</name>
        <description/>
        <dataType>String</dataType>
        <length>10</length>
        <precision/>
        <includeInChangeDataCapture>Y</includeInChangeDataCapture>
      </attributes>
      <parentKeySourceFields>
        <parentKeySourceField>customer_id</parentKeySourceField>
      </parentKeySourceFields>
      <drivingKey/>
      <drivingKeySourceField/>
      <recordSource>customer_address</recordSource>
      <storeRecordSource>Y</storeRecordSource>
      <statusTrackingEnabled>N</statusTrackingEnabled>
      <statusTableName/>
      <statusFieldName>record_status</statusFieldName>
      <activeStatusValue>ACTIVE</activeStatusValue>
      <deletedStatusValue>DELETED</deletedStatusValue>
      <tableName>s_customer_address</tableName>
      <description/>
      <tableType>SATELLITE</tableType>
      <integrationMode>HOP_MANAGED</integrationMode>
      <customUpdatePipelinePaths/>
      <xloc>464</xloc>
      <yloc>96</yloc>
      <name>s_customer_address</name>
      <virtualPath/>
    </table>
    <table>
      <hub>h_customer</hub>
      <link/>
      <attributes>
        <name>email</name>
        <description/>
        <dataType>String</dataType>
        <length>50</length>
        <precision/>
        <includeInChangeDataCapture>Y</includeInChangeDataCapture>
      </attributes>
      <attributes>
        <name>phone</name>
        <description/>
        <dataType>String</dataType>
        <length>20</length>
        <precision/>
        <includeInChangeDataCapture>Y</includeInChangeDataCapture>
      </attributes>
      <parentKeySourceFields>
        <parentKeySourceField>customer_id</parentKeySourceField>
      </parentKeySourceFields>
      <drivingKey/>
      <drivingKeySourceField/>
      <recordSource>customer_contact</recordSource>
      <storeRecordSource>Y</storeRecordSource>
      <statusTrackingEnabled>N</statusTrackingEnabled>
      <statusTableName/>
      <statusFieldName>record_status</statusFieldName>
      <activeStatusValue>ACTIVE</activeStatusValue>
      <deletedStatusValue>DELETED</deletedStatusValue>
      <tableName>s_customer_contact</tableName>
      <description/>
      <tableType>SATELLITE</tableType>
      <integrationMode>HOP_MANAGED</integrationMode>
      <customUpdatePipelinePaths/>
      <xloc>480</xloc>
      <yloc>160</yloc>
      <name>s_customer_contact</name>
      <virtualPath/>
    </table>
  </tables>
  <notes/>
  <name>target-vault-model</name>
</data-vault-model>

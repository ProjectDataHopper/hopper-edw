// ProjectDataHopper Neo4j Knowledge Graph Initialization
CREATE CONSTRAINT IF NOT EXISTS FOR (r:Repository) REQUIRE r.name IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (c:Class) REQUIRE c.qualifiedName IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (rule:CodingRule) REQUIRE rule.ruleId IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (f:FileType) REQUIRE f.extension IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (d:DocArticle) REQUIRE d.path IS UNIQUE;

MERGE (repo:Repository {name: 'hopper-edw'})
ON CREATE SET repo.org = 'ProjectDataHopper', repo.url = 'https://github.com/ProjectDataHopper/hopper-edw';

MERGE (rule:CodingRule {ruleId: 'RULE_VFS'}) ON CREATE SET rule.title = "Apache Commons VFS over java.io.File", rule.category = "File Access", rule.severity = "CRITICAL", rule.description = "Unless there really is no other choice, files must be read from or written to using Apache Commons VFS, HopVfs.getInputStream() or HopVfs.getOutputStream(). Use of java.io.File is strictly reserved for rare and exceptional cases. The default is org.apache.commons.vfs2.FileObject.", rule.goodExample = "try (InputStream in = HopVfs.getInputStream(filename)) {\n    FileObject fileObject = HopVfs.getFileObject(filename);\n    // process stream\n}", rule.badExample = "File file = new File(filename);\nFileInputStream fis = new FileInputStream(file);";
MATCH (repo:Repository {name: 'hopper-edw'}), (rule:CodingRule {ruleId: 'RULE_VFS'}) MERGE (repo)-[:ENFORCES_RULE]->(rule);
MERGE (rule:CodingRule {ruleId: 'RULE_GUI_GROUPS'}) ON CREATE SET rule.title = "Grouped GuiCompositeWidgets for Dialogs (No Flat Forms)", rule.category = "GUI & Dialogs", rule.severity = "CRITICAL", rule.description = "When building or changing a transform, action, metadata, or run-configuration dialog, do not hand-layout FormAttachment rows on the shell first. Start with annotated metadata widgets and a grouped GuiCompositeWidgets container. 1. Annotate Meta with @GuiPlugin and Lombok @Getter/@Setter.\n2. Define GUI_PLUGIN_ELEMENT_PARENT_ID.\n3. Annotate user-visible fields with @HopMetadataProperty and @GuiWidgetElement.\n4. Put every field in a group (groupType = GuiWidgetGroupType.BOXES or TABS).\n5. In open(): createShell(...), buildButtonBar(), then GuiCompositeWidgets.addScrolledComposite(...).\n6. On OK: widgets.getWidgetsContents(input, PARENT_ID). Do not copy fields by hand.", rule.goodExample = "@GuiWidgetElement(\n    id = WIDGET_DATA_SET_NAME,\n    order = \"0100\",\n    type = GuiElementType.METADATA,\n    parentId = GUI_PLUGIN_ELEMENT_PARENT_ID,\n    groupType = GuiWidgetGroupType.BOXES,\n    group = \"Data Set\")\n@HopMetadataProperty\nprivate String dataSetName;", rule.badExample = "// Hand-attaching flat FormAttachment rows directly beneath transform name,\n// causing OK/Cancel buttons to overlap widgets on resize.";
MATCH (repo:Repository {name: 'hopper-edw'}), (rule:CodingRule {ruleId: 'RULE_GUI_GROUPS'}) MERGE (repo)-[:ENFORCES_RULE]->(rule);
MERGE (rule:CodingRule {ruleId: 'RULE_GUI_BACKED'}) ON CREATE SET rule.title = "All Features Must Be GUI-Backed", rule.category = "Architecture", rule.severity = "HIGH", rule.description = "For Apache Hop related projects or sessions involving the Apache Hop API, avoid building any functionality that is only expressed in a file and not in a GUI element. Every metadata type, modeler feature, or transform option must have an accessible GUI control.", rule.goodExample = "Provide an editor dialog or visual canvas action for any new configuration property.", rule.badExample = "Adding JSON/XML properties that can only be set by manual text-editor modifications.";
MATCH (repo:Repository {name: 'hopper-edw'}), (rule:CodingRule {ruleId: 'RULE_GUI_BACKED'}) MERGE (repo)-[:ENFORCES_RULE]->(rule);
MERGE (rule:CodingRule {ruleId: 'RULE_LOMBOK'}) ON CREATE SET rule.title = "Mandatory Lombok Usage", rule.category = "Code Quality", rule.severity = "HIGH", rule.description = "Apache Hop and related projects must use Lombok (@Getter, @Setter, @EqualsAndHashCode, etc.) for all classes to avoid cluttering code with boilerplate getter/setter methods.", rule.goodExample = "@Getter\n@Setter\npublic class DataCatalogMeta implements IHopMetadata { ... }", rule.badExample = "Writing manual getX() and setX() methods for dozens of fields.";
MATCH (repo:Repository {name: 'hopper-edw'}), (rule:CodingRule {ruleId: 'RULE_LOMBOK'}) MERGE (repo)-[:ENFORCES_RULE]->(rule);
MERGE (rule:CodingRule {ruleId: 'RULE_I18N_QUOTES'}) ON CREATE SET rule.title = "Hop i18n Resource Bundle Single-Quote Escaping", rule.category = "Localization", rule.severity = "HIGH", rule.description = "Values defined in resource bundles (messages/messages*.properties) must be properly escaped. Variable expressions like ${VARIABLE} must be surrounded with single quotes: '${VARIABLE}'. Otherwise, MessageFormat drops them.", rule.goodExample = "MyTransform.Param.Tooltip = Specify folder path, e.g. '${HOP_DATASETS_FOLDER}'", rule.badExample = "MyTransform.Param.Tooltip = Specify folder path, e.g. ${HOP_DATASETS_FOLDER}";
MATCH (repo:Repository {name: 'hopper-edw'}), (rule:CodingRule {ruleId: 'RULE_I18N_QUOTES'}) MERGE (repo)-[:ENFORCES_RULE]->(rule);
MERGE (rule:CodingRule {ruleId: 'RULE_JAVA_PIN'}) ON CREATE SET rule.title = "Java 21 and Hop 2.20.0-SNAPSHOT Hard Pins", rule.category = "Build & Dependencies", rule.severity = "CRITICAL", rule.description = "Strictly compiled with JDK 21. Apache Hop pin is 2.20.0-SNAPSHOT (apache/hop#8330 AI Advisor, #8346 diagram exporters, #8297 Hop Web explorer HTML document base). Dependencies hop-core, hop-engine, and hop-ui are 'provided' by the runtime.", rule.goodExample = "<hop.version>2.20.0-SNAPSHOT</hop.version> with JDK 21 compiler release", rule.badExample = "Targeting Java 11 or Hop 2.11 without approval.";
MATCH (repo:Repository {name: 'hopper-edw'}), (rule:CodingRule {ruleId: 'RULE_JAVA_PIN'}) MERGE (repo)-[:ENFORCES_RULE]->(rule);
MERGE (f:FileType {extension: '.hdv'}) ON CREATE SET f.name = "Data Vault 2.0 Model", f.rootXml = "data-vault-model", f.summary = "Visual raw Data Vault model containing Hubs, Links, and Satellites.", f.antiPatterns = ["Do not put foreign keys or transaction attributes directly on Hubs.", "Do not skip Links between Hubs; relationships must be modeled via Links.", "Always include hash keys, load dates, and record sources on Satellites."];
MATCH (repo:Repository {name: 'hopper-edw'}), (f:FileType {extension: '.hdv'}) MERGE (repo)-[:SUPPORTS_FILE_TYPE]->(f);
MERGE (f:FileType {extension: '.hbv'}) ON CREATE SET f.name = "Business Vault Model", f.rootXml = "business-vault-model", f.summary = "Business Vault model containing Point-in-Time (PIT) tables, Bridges, SCD2 views, and calculated SQL views.", f.antiPatterns = ["Do not duplicate raw satellites into Business Vault without transformations.", "PIT tables require snapshot date ranges and valid satellite reference links."];
MATCH (repo:Repository {name: 'hopper-edw'}), (f:FileType {extension: '.hbv'}) MERGE (repo)-[:SUPPORTS_FILE_TYPE]->(f);
MERGE (f:FileType {extension: '.hdm'}) ON CREATE SET f.name = "Dimensional Model", f.rootXml = "dimensional-model", f.summary = "Star and Snowflake dimensional model containing Fact tables, Dimensions, Date dimension lookups, and Dimension Joins.", f.antiPatterns = ["Do not forget copies setting on fact dimension joins when scaling parallel lookups.", "Ensure surrogate keys and natural keys are clearly designated."];
MATCH (repo:Repository {name: 'hopper-edw'}), (f:FileType {extension: '.hdm'}) MERGE (repo)-[:SUPPORTS_FILE_TYPE]->(f);
MERGE (f:FileType {extension: '.hsm'}) ON CREATE SET f.name = "Source Model", f.rootXml = "source-model", f.summary = "Catalog-first source definition capturing physical databases, tables, SQL queries, and composite multi-table feeds.", f.antiPatterns = ["Do not invent source columns; harvest from database or read catalog definition JSON.", "Ensure catalog FILE store definitions match dvSource.fields or physicalTable.fields."];
MATCH (repo:Repository {name: 'hopper-edw'}), (f:FileType {extension: '.hsm'}) MERGE (repo)-[:SUPPORTS_FILE_TYPE]->(f);

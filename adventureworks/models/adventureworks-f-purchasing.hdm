      <tableName>f_purchase_order_line</tableName>
      <description>Purchase order line grain (PurchaseOrderID + PurchaseOrderDetailID)</description>
      <grain>purchase order + line</grain>
      <business_process>
        <business>Adventure Works Cycles</business>
        <level1>Purchasing</level1>
        <level2>Procurement</level2>
        <level3>Purchase order lines</level3>
      </business_process>
      <tableType>FACT</tableType>
      <sourceType>SQL</sourceType>
      <sourceConnection>Vault</sourceConnection>
      <sourceSql>SELECT
  hpod.purchaseorderid AS purchase_order_id,
  hpod.purchaseorderdetailid AS purchase_order_detail_id,
  hv.businessentity_hk AS vendor_hk,
  hp.product_hk,
  he.businessentity_hk AS employee_hk,
  soh.orderdate AS order_date,
  soh.shipdate AS ship_date,
  sat.duedate AS due_date,
  sat.orderqty AS order_qty,
  sat.unitprice AS unit_price,
  sat.linetotal AS line_total,
  sat.receivedqty AS received_qty,
  sat.rejectedqty AS rejected_qty,
  sat.stockedqty AS stocked_qty
FROM lnk_purchaseorderdetail_product lp
JOIN hub_purchaseorderdetail hpod
  ON hpod.purchaseorderdetail_hk = lp.purchaseorderdetail_hk
JOIN (
  SELECT DISTINCT ON (purchaseorderdetail_hk) *
  FROM sat_purchaseorderdetail
  ORDER BY purchaseorderdetail_hk, x_load_ts DESC
) sat ON sat.purchaseorderdetail_hk = hpod.purchaseorderdetail_hk
JOIN hub_product hp
  ON hp.product_hk = lp.product_hk
JOIN lnk_purchaseorderdetail_purchaseorderheader lh
  ON lh.purchaseorderdetail_hk = hpod.purchaseorderdetail_hk
JOIN (
  SELECT DISTINCT ON (purchaseorderheader_hk) *
  FROM sat_purchaseorderheader
  ORDER BY purchaseorderheader_hk, x_load_ts DESC
) soh ON soh.purchaseorderheader_hk = lh.purchaseorderheader_hk
JOIN lnk_purchaseorderheader_vendor lv
  ON lv.purchaseorderheader_hk = lh.purchaseorderheader_hk
JOIN hub_businessentity hv
  ON hv.businessentity_hk = lv.businessentity_hk
LEFT JOIN lnk_purchaseorderheader_employee le
  ON le.purchaseorderheader_hk = lh.purchaseorderheader_hk
LEFT JOIN hub_businessentity he
  ON he.businessentity_hk = le.businessentity_hk</sourceSql>
      <dimensionLookupDateField>order_date</dimensionLookupDateField>
      <xloc>400</xloc>
      <yloc>336</yloc>
      <name>f_purchase_order_line</name>

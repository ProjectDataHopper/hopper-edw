      <natural_keys>
        <natural_key>
          <fieldName>date_key</fieldName>
        </natural_key>
      </natural_keys>
      <attributes>
        <attribute>
          <fieldName>day_of_month</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>day_of_week</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>day_of_year</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>full_date</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>is_weekend</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>month</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>month_name</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>quarter</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>week_of_year</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>year</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
      </attributes>
      <outriggers/>
      <surrogateKeyField/>
      <surrogateKeyStrategy>NONE</surrogateKeyStrategy>
      <surrogateKeySourceField/>
      <tableName>d_date</tableName>
      <description>Calendar date dimension covering AdventureWorks 2025 order dates</description>
      <tableType>DIMENSION</tableType>
      <sourceType>DATE_GENERATOR</sourceType>
      <sourceConnection/>
      <sourceSql/>
      <dateGenerator>
        <startDate>2022-01-01</startDate>
        <endDate>2026-12-31</endDate>
        <referenceDate/>
        <dayOffset>0</dayOffset>
        <weekOffset>0</weekOffset>
        <monthOffset>0</monthOffset>
        <fields>
          <field>
            <name>date_key</name>
            <hopType>5</hopType>
            <length>8</length>
            <precision>0</precision>
            <formatMask>yyyyMMdd</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>full_date</name>
            <hopType>3</hopType>
            <length/>
            <precision/>
            <formatMask>yyyy-MM-dd</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>day_of_week</name>
            <hopType>5</hopType>
            <length>1</length>
            <precision>0</precision>
            <formatMask>@day_of_week</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>day_of_month</name>
            <hopType>5</hopType>
            <length>2</length>
            <precision>0</precision>
            <formatMask>d</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>day_of_year</name>
            <hopType>5</hopType>
            <length>3</length>
            <precision>0</precision>
            <formatMask>D</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>week_of_year</name>
            <hopType>5</hopType>
            <length>2</length>
            <precision>0</precision>
            <formatMask>w</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>month</name>
            <hopType>5</hopType>
            <length>2</length>
            <precision>0</precision>
            <formatMask>M</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>month_name</name>
            <hopType>2</hopType>
            <length>20</length>
            <precision>0</precision>
            <formatMask>MMMM</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>quarter</name>
            <hopType>5</hopType>
            <length>1</length>
            <precision>0</precision>
            <formatMask>Q</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>year</name>
            <hopType>5</hopType>
            <length>4</length>
            <precision>0</precision>
            <formatMask>yyyy</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>is_weekend</name>
            <hopType>4</hopType>
            <length/>
            <precision/>
            <formatMask>@is_weekend</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>x_load_ts</name>
            <hopType>9</hopType>
            <length/>
            <precision/>
            <formatMask>@now</formatMask>
            <locale/>
          </field>
        </fields>
      </dateGenerator>
      <xloc>128</xloc>
      <yloc>80</yloc>
      <name>d_date</name>
    </table>

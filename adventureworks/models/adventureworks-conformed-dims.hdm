          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
      </attributes>
      <outriggers/>
      <surrogateKeyField>employee_hk</surrogateKeyField>
      <surrogateKeyStrategy>USE_SOURCE_FIELD</surrogateKeyStrategy>
      <surrogateKeySourceField>employee_hk</surrogateKeySourceField>
      <tableName>d_employee</tableName>
      <description>Current employee (salesperson / buyer) from bv_employee</description>
      <tableType>DIMENSION</tableType>
      <sourceType>SQL</sourceType>
      <sourceConnection>Vault</sourceConnection>
      <sourceSql>SELECT employee_id,
       businessentity_hk AS employee_hk,
       first_name,
       last_name,
       job_title,
       hire_date,
       organization_level,
       current_flag,
       gender,
       marital_status,
       x_load_ts
FROM   bv_employee</sourceSql>
      <xloc>128</xloc>
      <yloc>464</yloc>
      <name>d_employee</name>
    </table>
    <table>
      <scdType>TYPE1</scdType>
      <natural_keys>
        <natural_key>
          <fieldName>territory_id</fieldName>
        </natural_key>
      </natural_keys>
      <attributes>
        <attribute>
          <fieldName>territory_name</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>territory_group</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
      </attributes>
      <outriggers/>
      <surrogateKeyField>salesterritory_hk</surrogateKeyField>
      <surrogateKeyStrategy>USE_SOURCE_FIELD</surrogateKeyStrategy>
      <surrogateKeySourceField>salesterritory_hk</surrogateKeySourceField>
      <tableName>d_sales_territory</tableName>
      <description>Sales territory</description>
      <tableType>DIMENSION</tableType>
      <sourceType>SQL</sourceType>
      <sourceConnection>Vault</sourceConnection>
      <sourceSql>SELECT ht.territoryid AS territory_id,
       latest.salesterritory_hk,
       latest.name AS territory_name,
       latest."group" AS territory_group,
       latest.x_load_ts
FROM (
  SELECT DISTINCT ON (salesterritory_hk) *
  FROM sat_salesterritory
  ORDER BY salesterritory_hk, x_load_ts DESC
) latest
JOIN hub_salesterritory ht
  ON ht.salesterritory_hk = latest.salesterritory_hk</sourceSql>
      <xloc>128</xloc>
      <yloc>592</yloc>
      <name>d_sales_territory</name>
    </table>
    <table>
      <scdType>TYPE1</scdType>
      <natural_keys>
        <natural_key>
          <fieldName>vendor_id</fieldName>
        </natural_key>
      </natural_keys>
      <attributes>
        <attribute>
          <fieldName>vendor_name</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>account_number</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>credit_rating</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>preferred_vendor</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>active_flag</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
      </attributes>
      <outriggers/>
      <surrogateKeyField>vendor_hk</surrogateKeyField>
      <surrogateKeyStrategy>USE_SOURCE_FIELD</surrogateKeyStrategy>
      <surrogateKeySourceField>vendor_hk</surrogateKeySourceField>
      <tableName>d_vendor</tableName>
      <description>Vendor (BusinessEntity + sat_vendor)</description>
      <tableType>DIMENSION</tableType>
      <sourceType>SQL</sourceType>
      <sourceConnection>Vault</sourceConnection>
      <sourceSql>SELECT he.businessentityid AS vendor_id,
       sv.businessentity_hk AS vendor_hk,
       sv.name AS vendor_name,
       sv.accountnumber AS account_number,
       sv.creditrating AS credit_rating,
       sv.preferredvendorstatus AS preferred_vendor,
       sv.activeflag AS active_flag,
       sv.x_load_ts
FROM (
  SELECT DISTINCT ON (businessentity_hk) *
  FROM sat_vendor
  ORDER BY businessentity_hk, x_load_ts DESC
) sv
JOIN hub_businessentity he
  ON he.businessentity_hk = sv.businessentity_hk</sourceSql>
      <xloc>128</xloc>
      <yloc>720</yloc>
      <name>d_vendor</name>
    </table>
  </tables>
  <conformed_dimensions/>
  <notes/>
  <name>adventureworks-conformed-dims</name>

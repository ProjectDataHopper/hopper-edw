      <tableName>d_customer</tableName>
      <description>Current customer 360 (Person or Store)</description>
      <tableType>DIMENSION</tableType>
      <sourceType>SQL</sourceType>
      <sourceConnection>Vault</sourceConnection>
      <sourceSql>SELECT customer_id,
       customer_hk,
       account_number,
       customer_type,
       first_name,
       last_name,
       title,
       email_address,
       store_name,
       display_name,
       territory_name,
       territory_group,
       x_load_ts
FROM   bv_customer_360
WHERE  x_to_ts = TIMESTAMP '9999-12-31 23:59:59'</sourceSql>
      <xloc>128</xloc>
      <yloc>208</yloc>
      <name>d_customer</name>
    </table>

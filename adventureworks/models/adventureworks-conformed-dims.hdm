      <tableName>d_product</tableName>
      <description>Current product 360 with subcategory and category</description>
      <tableType>DIMENSION</tableType>
      <sourceType>SQL</sourceType>
      <sourceConnection>Vault</sourceConnection>
      <sourceSql>SELECT product_id,
       product_hk,
       product_name,
       product_number,
       color,
       list_price,
       standard_cost,
       size,
       product_line,
       product_class,
       style,
       make_flag,
       finished_goods_flag,
       subcategory_name,
       category_name,
       x_load_ts
FROM   bv_product_360
WHERE  x_to_ts = TIMESTAMP '9999-12-31 23:59:59'</sourceSql>
      <xloc>128</xloc>
      <yloc>336</yloc>
      <name>d_product</name>
    </table>
    <table>
      <scdType>TYPE1</scdType>
      <natural_keys>

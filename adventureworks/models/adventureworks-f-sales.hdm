      <tableName>f_sales_order_line</tableName>
      <description>Sales order line grain (SalesOrderID + SalesOrderDetailID)</description>
      <grain>sales order + line</grain>
      <business_process>
        <business>Adventure Works Cycles</business>
        <level1>Sales</level1>
        <level2>Order management</level2>
        <level3>Sales order lines</level3>
      </business_process>
      <tableType>FACT</tableType>
      <sourceType>SQL</sourceType>
      <sourceConnection>Vault</sourceConnection>
      <sourceSql>SELECT
  hsd.salesorderid AS sales_order_id,
  hsd.salesorderdetailid AS sales_order_detail_id,
  soh.salesordernumber AS sales_order_number,
  hc.customer_hk,
  hp.product_hk,
  hsp.businessentity_hk AS employee_hk,
  ht.salesterritory_hk,
  soh.orderdate AS order_date,
  soh.duedate AS due_date,
  soh.shipdate AS ship_date,
  sat.orderqty AS order_qty,
  sat.unitprice AS unit_price,
  sat.unitpricediscount AS unit_price_discount,
  sat.linetotal AS line_total
FROM lnk_salesorderdetail_product lp
JOIN hub_salesorderdetail hsd
  ON hsd.salesorderdetail_hk = lp.salesorderdetail_hk
JOIN (
  SELECT DISTINCT ON (salesorderdetail_hk) *
  FROM sat_salesorderdetail
  ORDER BY salesorderdetail_hk, x_load_ts DESC
) sat ON sat.salesorderdetail_hk = hsd.salesorderdetail_hk
JOIN hub_product hp
  ON hp.product_hk = lp.product_hk
JOIN lnk_salesorderdetail_salesorderheader lsh
  ON lsh.salesorderdetail_hk = hsd.salesorderdetail_hk
JOIN (
  SELECT DISTINCT ON (salesorderheader_hk) *
  FROM sat_salesorderheader
  ORDER BY salesorderheader_hk, x_load_ts DESC
) soh ON soh.salesorderheader_hk = lsh.salesorderheader_hk
JOIN lnk_salesorderheader_customer lc
  ON lc.salesorderheader_hk = lsh.salesorderheader_hk
JOIN hub_customer hc
  ON hc.customer_hk = lc.customer_hk
LEFT JOIN lnk_salesorderheader_salesperson lsp
  ON lsp.salesorderheader_hk = lsh.salesorderheader_hk
LEFT JOIN hub_businessentity hsp
  ON hsp.businessentity_hk = lsp.businessentity_hk
LEFT JOIN lnk_salesorderheader_salesterritory lt
  ON lt.salesorderheader_hk = lsh.salesorderheader_hk
LEFT JOIN hub_salesterritory ht
  ON ht.salesterritory_hk = lt.salesterritory_hk</sourceSql>
      <dimensionLookupDateField>order_date</dimensionLookupDateField>
      <xloc>400</xloc>
      <yloc>336</yloc>
      <name>f_sales_order_line</name>

      <tableName>pit_employee</tableName>
      <description>Daily PIT of sat_employee on hub_businessentity (Person/Store/Vendor sats on the same hub are unlisted)</description>
      <tableType>PIT</tableType>
      <derivatives>
        <derivative>
          <dvTableName>hub_businessentity</dvTableName>
          <dvTableType>HUB</dvTableType>
        </derivative>
        <derivative>
          <dvTableName>sat_employee</dvTableName>
          <dvTableType>SATELLITE</dvTableType>
        </derivative>
      </derivatives>
      <xloc>400</xloc>
      <yloc>576</yloc>
      <name>pit_employee</name>
    </table>
    <table>
      <sqlQuery>SELECT
  he.businessentityid AS employee_id,
  se.businessentity_hk,
  sp.firstname AS first_name,
  sp.lastname AS last_name,
  se.jobtitle AS job_title,
  se.hiredate AS hire_date,
  se.organizationlevel AS organization_level,
  se.currentflag AS current_flag,
  se.gender,
  se.maritalstatus AS marital_status,
  se.x_load_ts
FROM (
  SELECT DISTINCT ON (businessentity_hk) *
  FROM {{ ref('adventureworks', 'sat_employee') }}
  ORDER BY businessentity_hk, x_load_ts DESC
) se
JOIN {{ ref('adventureworks', 'hub_businessentity') }} he
  ON he.businessentity_hk = se.businessentity_hk
LEFT JOIN (
  SELECT DISTINCT ON (businessentity_hk) *
  FROM {{ ref('adventureworks', 'sat_person') }}
  ORDER BY businessentity_hk, x_load_ts DESC
) sp ON sp.businessentity_hk = se.businessentity_hk</sqlQuery>

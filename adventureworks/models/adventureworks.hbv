      <tableName>bv_product_scd2</tableName>
      <description>SCD2 of sat_product at hub_product grain</description>
      <tableType>SCD2</tableType>
      <derivatives>
        <derivative>
          <dvTableName>hub_product</dvTableName>
          <dvTableType>HUB</dvTableType>

      <tableName>bv_customer_scd2</tableName>
      <description>SCD2 of sat_customer at hub_customer grain (Person/Store/email live on other hubs)</description>
      <tableType>SCD2</tableType>
      <derivatives>
        <derivative>
          <dvTableName>hub_customer</dvTableName>
          <dvTableType>HUB</dvTableType>
        </derivative>
        <derivative>
          <dvTableName>sat_customer</dvTableName>
          <dvTableType>SATELLITE</dvTableType>
        </derivative>
      </derivatives>
      <source_query_refs/>
      <xloc>400</xloc>
      <yloc>160</yloc>
      <name>bv_customer_scd2</name>
    </table>
    <table>
      <sqlQuery>SELECT
  c.customer_hk,
  hc.customerid AS customer_id,
  c.accountnumber AS account_number,
  CASE
    WHEN lcp.businessentity_hk IS NOT NULL THEN 'Person'
    WHEN lcs.businessentity_hk IS NOT NULL THEN 'Store'
    ELSE 'Unknown'
  END AS customer_type,
  sp.firstname AS first_name,
  sp.lastname AS last_name,
  sp.title,
  em.emailaddress AS email_address,
  st.name AS store_name,
  COALESCE(
    NULLIF(TRIM(BOTH FROM CONCAT_WS(' ', sp.firstname, sp.lastname)), ''),
    st.name
  ) AS display_name,
  ter.name AS territory_name,
  ter.territory_group,
  c.x_from_ts,
  c.x_to_ts,
  c.x_load_ts
FROM {{ ref('bv_customer_scd2') }} c
JOIN {{ ref('adventureworks', 'hub_customer') }} hc
  ON hc.customer_hk = c.customer_hk
LEFT JOIN {{ ref('adventureworks', 'lnk_customer_person') }} lcp
  ON lcp.customer_hk = c.customer_hk
LEFT JOIN (
  SELECT DISTINCT ON (businessentity_hk) *
  FROM {{ ref('adventureworks', 'sat_person') }}
  ORDER BY businessentity_hk, x_load_ts DESC
) sp ON sp.businessentity_hk = lcp.businessentity_hk
LEFT JOIN {{ ref('adventureworks', 'lnk_customer_store') }} lcs
  ON lcs.customer_hk = c.customer_hk
LEFT JOIN (
  SELECT DISTINCT ON (businessentity_hk) *
  FROM {{ ref('adventureworks', 'sat_store') }}
  ORDER BY businessentity_hk, x_load_ts DESC
) st ON st.businessentity_hk = lcs.businessentity_hk
LEFT JOIN {{ ref('adventureworks', 'lnk_customer_salesterritory') }} lct
  ON lct.customer_hk = c.customer_hk
LEFT JOIN (
  SELECT
    salesterritory_hk,
    name,
    "group" AS territory_group
  FROM (
    SELECT DISTINCT ON (salesterritory_hk) *
    FROM {{ ref('adventureworks', 'sat_salesterritory') }}
    ORDER BY salesterritory_hk, x_load_ts DESC
  ) latest_territory
) ter ON ter.salesterritory_hk = lct.salesterritory_hk
LEFT JOIN LATERAL (
  SELECT sea.emailaddress
  FROM {{ ref('adventureworks', 'lnk_emailaddress') }} le
  JOIN {{ ref('adventureworks', 'sat_emailaddress') }} sea
    ON sea.emailaddress_hk = le.emailaddress_hk
  WHERE le.businessentity_hk = lcp.businessentity_hk
  ORDER BY sea.x_load_ts DESC
  LIMIT 1
) em ON TRUE</sqlQuery>

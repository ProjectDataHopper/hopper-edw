      <source_query_refs/>
      <xloc>400</xloc>
      <yloc>368</yloc>
      <name>bv_product_scd2</name>
    </table>
    <table>
      <sqlQuery>SELECT
  p.product_hk,
  hp.productid AS product_id,
  p.name AS product_name,
  p.productnumber AS product_number,
  p.color,
  p.listprice AS list_price,
  p.standardcost AS standard_cost,
  p.size,
  p.productline AS product_line,
  p."class" AS product_class,
  p.style,
  p.makeflag AS make_flag,
  p.finishedgoodsflag AS finished_goods_flag,
  ss.name AS subcategory_name,
  sc.name AS category_name,
  p.x_from_ts,
  p.x_to_ts,
  p.x_load_ts
FROM {{ ref('bv_product_scd2') }} p
JOIN {{ ref('adventureworks', 'hub_product') }} hp
  ON hp.product_hk = p.product_hk
LEFT JOIN {{ ref('adventureworks', 'lnk_product_productsubcategory') }} lps
  ON lps.product_hk = p.product_hk
LEFT JOIN (
  SELECT DISTINCT ON (productsubcategory_hk) *
  FROM {{ ref('adventureworks', 'sat_productsubcategory') }}
  ORDER BY productsubcategory_hk, x_load_ts DESC
) ss ON ss.productsubcategory_hk = lps.productsubcategory_hk
LEFT JOIN {{ ref('adventureworks', 'lnk_productsubcategory') }} lpc
  ON lpc.productsubcategory_hk = lps.productsubcategory_hk
LEFT JOIN (
  SELECT DISTINCT ON (productcategory_hk) *
  FROM {{ ref('adventureworks', 'sat_productcategory') }}
  ORDER BY productcategory_hk, x_load_ts DESC
) sc ON sc.productcategory_hk = lpc.productcategory_hk</sqlQuery>

<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>hop-misc-datavault</id>
    <formats>
        <format>zip</format>
    </formats>
    <baseDirectory>.</baseDirectory>
    <files>
        <file>
            <source>${project.basedir}/src/main/resources/version.xml</source>
            <outputDirectory>plugins/misc/datavault/</outputDirectory>
            <filtered>true</filtered>
        </file>
        <file>
            <source>${project.basedir}/README.md</source>
            <outputDirectory>plugins/misc/datavault/</outputDirectory>
            <filtered>true</filtered>
        </file>
        <file>
            <source>${project.basedir}/src/main/resources/dependencies.xml</source>
            <outputDirectory>plugins/misc/datavault/</outputDirectory>
            <filtered>true</filtered>
        </file>
        <!-- Thin hop-hsm JDBC driver for DatabaseMeta type "Apache Hop Source Model" -->
        <file>
            <source>${project.basedir}/hop-hsm-jdbc/target/hop-hsm-jdbc-${project.version}.jar</source>
            <outputDirectory>plugins/misc/datavault/lib</outputDirectory>
            <destName>hop-hsm-jdbc-${project.version}.jar</destName>
        </file>
    </files>
    <fileSets>
        <fileSet>
            <directory>${project.build.directory}/generated-docs</directory>
            <outputDirectory>plugins/misc/datavault/docs</outputDirectory>
        </fileSet>
    </fileSets>
    <dependencySets>
        <dependencySet>
            <includes>
                <include>org.projectdatahopper.hop:hopper-edw:jar</include>
            </includes>
            <outputDirectory>plugins/misc/datavault/</outputDirectory>
        </dependencySet>
        <dependencySet>
            <includes>
                <include>org.commonmark:*</include>
            </includes>
            <outputDirectory>plugins/misc/datavault/lib</outputDirectory>
            <useTransitiveDependencies>true</useTransitiveDependencies>
            <useProjectArtifact>false</useProjectArtifact>
        </dependencySet>
        <!--
          Calcite free-SQL engine (issue #117). Includes must list transitive runtime jars
          that do not match org.apache.calcite:* — assembly filters by groupId/artifactId.
          Missing locationtech.jts caused NoClassDefFoundError: Geometry at PlannerImpl.rel().
        -->
        <dependencySet>
            <includes>
                <include>org.apache.calcite:*</include>
                <include>org.apache.calcite.avatica:*</include>
                <include>org.locationtech.jts:*</include>
                <include>org.locationtech.jts.io:*</include>
                <include>org.locationtech.proj4j:*</include>
                <!-- Calcite expression compilation (Planner / Enumerable) -->
                <include>org.codehaus.janino:janino</include>
                <include>org.codehaus.janino:commons-compiler</include>
                <!-- Calcite BuiltInMethod / metadata paths -->
                <include>org.apache.commons:commons-math3</include>
                <include>org.apache.commons:commons-text</include>
                <include>com.jayway.jsonpath:json-path</include>
            </includes>
            <outputDirectory>plugins/misc/datavault/lib</outputDirectory>
            <useTransitiveDependencies>true</useTransitiveDependencies>
            <useProjectArtifact>false</useProjectArtifact>
        </dependencySet>
        <dependencySet>
            <includes>
                <include>org.eclipse.elk:*</include>
                <include>org.eclipse.emf:*</include>
            </includes>
            <outputDirectory>plugins/misc/datavault/lib</outputDirectory>
            <useTransitiveDependencies>true</useTransitiveDependencies>
            <useProjectArtifact>false</useProjectArtifact>
        </dependencySet>
        <dependencySet>
            <includes>
                <include>org.apache.iceberg:iceberg-hive-runtime</include>
                <include>org.apache.hadoop:*</include>
                <include>org.apache.httpcomponents:*</include>
            </includes>
            <outputDirectory>plugins/misc/datavault/lib</outputDirectory>
            <useTransitiveDependencies>true</useTransitiveDependencies>
            <useProjectArtifact>false</useProjectArtifact>
        </dependencySet>
        <!--
          Jinjava (issue #72) on Hop's system classpath. Shaded JUEL loads
          ExtendedSyntaxBuilder via the application TCCL; plugin-lib isolation
          made that ClassNotFoundException in Hop GUI. Do not also copy these
          into plugins/misc/datavault/lib (two copies of the same classes).
          Guava, Jackson core/databind, jsoup, javassist, re2j, and snakeyaml
          are already in Hop lib/core. jackson-dataformat-yaml is not — Jinjava
          FromYamlFilter needs YAMLMapper on the same loader as jinjava.
        -->
        <dependencySet>
            <includes>
                <include>com.hubspot.jinjava:jinjava</include>
                <include>com.hubspot.immutables:immutables-exceptions</include>
                <include>com.hubspot:algebra</include>
                <include>ch.obermuhlner:big-math</include>
                <include>com.googlecode.java-ipv6:java-ipv6</include>
                <include>com.fasterxml.jackson.dataformat:jackson-dataformat-yaml</include>
            </includes>
            <outputDirectory>lib/core</outputDirectory>
            <useTransitiveDependencies>true</useTransitiveDependencies>
            <useProjectArtifact>false</useProjectArtifact>
        </dependencySet>
        <dependencySet>
            <includes>
                <include>org.apache.hop:hop-action-sql:jar</include>
                <include>org.apache.hop:hop-action-success:jar</include>
                <include>org.apache.hop:hop-transform-analyticquery:jar</include>
                <include>org.apache.hop:hop-transform-append:jar</include>
                <include>org.apache.hop:hop-transform-calculator:jar</include>
                <include>org.apache.hop:hop-transform-checksum:jar</include>
                <include>org.apache.hop:hop-transform-combinationlookup:jar</include>
                <include>org.apache.hop:hop-transform-concatfields:jar</include>
                <include>org.apache.hop:hop-transform-constant:jar</include>
                <include>org.apache.hop:hop-transform-dimensionlookup:jar</include>
                <include>org.apache.hop:hop-transform-filemetadata:jar</include>
                <include>org.apache.hop:hop-transform-filterrows:jar</include>
                <include>org.apache.hop:hop-transform-getfilenames:jar</include>
                <include>org.apache.hop:hop-transform-groupby:jar</include>
                <include>org.apache.hop:hop-transform-ifnull:jar</include>
                <include>org.apache.hop:hop-transform-insertupdate:jar</include>
                <include>org.apache.hop:hop-transform-languagemodelchat:jar</include>
                <include>org.apache.hop:hop-transform-mergejoin:jar</include>
                <include>org.apache.hop:hop-transform-mergerows:jar</include>
                <include>org.apache.hop:hop-transform-metainject:jar</include>
                <include>org.apache.hop:hop-transform-metastructure:jar</include>
                <include>org.apache.hop:hop-transform-numberrange:jar</include>
                <include>org.apache.hop:hop-transform-pipelineexecutor:jar</include>
                <include>org.apache.hop:hop-transform-repeatfields:jar</include>
                <include>org.apache.hop:hop-transform-rowgenerator:jar</include>
                <include>org.apache.hop:hop-transform-selectvalues:jar</include>
                <include>org.apache.hop:hop-transform-sort:jar</include>
                <include>org.apache.hop:hop-transform-sql:jar</include>
                <include>org.apache.hop:hop-transform-tableinput:jar</include>
                <include>org.apache.hop:hop-transform-tableoutput:jar</include>
                <include>org.apache.hop:hop-transform-textfile:jar</include>
                <include>org.apache.hop:hop-transform-uniquerowsbyhashset:jar</include>
                <include>org.apache.hop:hop-transform-update:jar</include>
            </includes>
            <outputDirectory>plugins/misc/datavault/lib</outputDirectory>
        </dependencySet>
    </dependencySets>
</assembly>

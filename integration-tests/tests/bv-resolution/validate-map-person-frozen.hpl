<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>validate-map-person-frozen</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/25 00:00:00.000</created_date>
    <modified_date>2026/09/25 00:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>map_person_bvr</name>
    <sql>SELECT h.person_id
, CAST(m.rule_version AS VARCHAR(10)) AS rule_version
, CASE WHEN m.hk_durable = snap.hk_durable THEN 'Y' ELSE 'N' END AS durable_frozen
, CASE WHEN m.hk_master = k.person_hk THEN 'Y' ELSE 'N' END AS master_is_k100
, CASE WHEN shared.durable_count = 1 AND shared.member_count = 2 THEN 'Y' ELSE 'N' END AS shared_durable
FROM map_person_bvr m
JOIN bv_resolution_map_snapshot snap ON snap.hk_raw = m.hk_raw
JOIN hub_person_bvr h ON h.person_hk = m.hk_raw
JOIN hub_person_bvr k ON k.person_id = 'K100'
JOIN (
  SELECT COUNT(DISTINCT m2.hk_durable) AS durable_count
  , COUNT(*) AS member_count
  FROM map_person_bvr m2
  JOIN hub_person_bvr h2 ON h2.person_hk = m2.hk_raw
  WHERE h2.person_id IN ('O100', 'K100')
) shared ON 1 = 1
WHERE h.person_id IN ('O100', 'K100')
ORDER BY h.person_id
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>Vault</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Validate</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>368</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>map_person_bvr</from>
      <to>Validate</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>

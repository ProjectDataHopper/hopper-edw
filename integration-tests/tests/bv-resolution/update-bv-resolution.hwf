      <doNotUpdateTargetDatabase>N</doNotUpdateTargetDatabase>
      <updateTargetDatabaseStructure>Y</updateTargetDatabaseStructure>
      <ddlSqlFilename/>
      <failIfDdlNeeded>N</failIfDdlNeeded>
      <name>Business Vault Update</name>
      <description/>
      <type>BUSINESS_VAULT_UPDATE</type>
      <attributes/>
      <xloc>1168</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <test_names>
        <test_name>
          <name>validate-bv-person UNIT</name>
        </test_name>
        <test_name>
          <name>validate-bv-person-excluded UNIT</name>
        </test_name>
        <test_name>
          <name>validate-map-person-initial UNIT</name>
        </test_name>
      </test_names>
      <name>test after initial</name>
      <description/>
      <type>RunPipelineTests</type>
      <attributes/>
      <xloc>1360</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>DROP TABLE IF EXISTS bv_resolution_map_snapshot
;
CREATE TABLE bv_resolution_map_snapshot AS
SELECT hk_raw, hk_durable, hk_master, rule_version
FROM map_person_bvr
;
</sql>
      <connection>Vault</connection>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>N</sendOneStatement>
      <name>snapshot identity map</name>
      <description>Keep the first durable assignment so the flipped master can be compared</description>
      <type>SQL</type>
      <attributes/>
      <xloc>400</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/tests/bv-resolution/load-bv-resolution-2.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>

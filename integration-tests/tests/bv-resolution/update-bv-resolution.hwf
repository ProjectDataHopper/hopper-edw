<workflow>
  <name>update-bv-resolution</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Postgres proof of calendar cutover, identity freeze, and ranked survivorship</description>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/09/25 00:00:00.000</created_date>
  <modified_date>2026/09/25 00:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>DV_INITIAL_LOAD_DATE</name>
      <description>Load date inside the Oracle window and before the Kafka window</description>
      <default_value>2024/02/15 00:00:00.000</default_value>
    </parameter>
    <parameter>
      <name>DV_UPDATE_LOAD_DATE</name>
      <description>Load date inside the Kafka window and after the Oracle window</description>
      <default_value>2024/03/15 00:00:00.000</default_value>
    </parameter>
    <parameter>
      <name>OUTPUT_COPIES</name>
      <default_value>1</default_value>
    </parameter>
    <parameter>
      <name>PIPELINE_COPIES</name>
      <default_value>1</default_value>
    </parameter>
    <parameter>
      <name>METRICS_FOLDER</name>
      <default_value>${PROJECT_HOME}/metrics</default_value>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>48</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>DROP TABLE IF EXISTS bv_resolution_map_snapshot
;
DROP TABLE IF EXISTS bv_person_bvr
;
DROP TABLE IF EXISTS map_person_bvr
;
DROP TABLE IF EXISTS sat_person_oracle_bvr
;
DROP TABLE IF EXISTS sat_person_kafka_bvr
;
DROP TABLE IF EXISTS lnk_person_same_as_bvr
;
DROP TABLE IF EXISTS hub_person_bvr
;
</sql>
      <connection>Vault</connection>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>N</sendOneStatement>
      <name>drop bv-resolution vault tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <xloc>208</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/tests/shared/create-source-tables-from-data-catalog.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>create CRM source tables</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>400</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>

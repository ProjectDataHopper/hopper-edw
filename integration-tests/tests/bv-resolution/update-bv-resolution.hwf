      <doNotUpdateTargetDatabase>N</doNotUpdateTargetDatabase>
      <name>update bv-resolution.hdv</name>
      <description/>
      <type>DATA_VAULT_UPDATE</type>
      <attributes/>
      <xloc>976</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>

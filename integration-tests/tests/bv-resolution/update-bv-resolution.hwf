      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>load-bv-resolution-2</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>592</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>UPDATE person_oracle_bvr SET city = NULL WHERE city = ''
;
UPDATE person_kafka_bvr SET city = NULL WHERE city = ''
;
</sql>
      <connection>CRM</connection>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>N</sendOneStatement>
      <name>null empty cities 2</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <xloc>784</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>DELETE FROM lnk_person_same_as_bvr
;
</sql>
      <connection>Vault</connection>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>Y</sendOneStatement>
      <name>delete same-as link</name>
      <description>Links are insert-only, so the flipped edge replaces the wave-1 edge</description>
      <type>SQL</type>
      <attributes/>
      <xloc>976</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <dataVaultModelFile>${PROJECT_HOME}/tests/bv-resolution/bv-resolution.hdv</dataVaultModelFile>
      <pipelineRunConfiguration>local</pipelineRunConfiguration>
      <logModelCheckFailures>Y</logModelCheckFailures>
      <abortOnModelCheckFailures>Y</abortOnModelCheckFailures>
      <detailedDataTypeChecking>N</detailedDataTypeChecking>
      <parallelPipelineCopies>${PIPELINE_COPIES}</parallelPipelineCopies>
      <pipelineStagingFolder/>
      <metricsOutputFolder>${METRICS_FOLDER}</metricsOutputFolder>
      <publishToCatalog>N</publishToCatalog>
      <updateTargetDatabaseStructure>N</updateTargetDatabaseStructure>
      <ddlSqlFilename/>
      <failIfDdlNeeded>N</failIfDdlNeeded>

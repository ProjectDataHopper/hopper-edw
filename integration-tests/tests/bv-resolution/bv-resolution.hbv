<business-vault-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Postgres proof: Oracle/Kafka cutover, frozen durable key, Kafka email rank 1</description>
  <dataVaultModelPath>${PROJECT_HOME}/tests/bv-resolution/bv-resolution.hdv</dataVaultModelPath>
  <configurationName>business-vault</configurationName>
  <coaching>
    <coaching_sources/>
  </coaching>
  <tables>
    <table>
      <buildMode>FULL_REBUILD</buildMode>
      <hashKeyPartitionCount>NONE</hashKeyPartitionCount>
      <functionalTimestampField>x_load_ts</functionalTimestampField>
      <validFromField/>
      <validToField/>
      <includeHashKey>Y</includeHashKey>
      <includeHubBusinessKeys>N</includeHubBusinessKeys>
      <parentHubName>hub_person_bvr</parentHubName>
      <sourceCalendarName>person_sources</sourceCalendarName>
      <identityMapName>map_person_bvr</identityMapName>
      <field_mappings>
        <field_mapping>
          <satelliteName>sat_person_oracle_bvr</satelliteName>
          <sourceFieldName>email</sourceFieldName>
          <targetFieldName>email</targetFieldName>
          <calculationOnly>N</calculationOnly>
          <rank>2</rank>
          <nullPolicy>apply</nullPolicy>
          <presentFlagField/>
        </field_mapping>
        <field_mapping>
          <satelliteName>sat_person_kafka_bvr</satelliteName>
          <sourceFieldName>email</sourceFieldName>
          <targetFieldName>email</targetFieldName>
          <calculationOnly>N</calculationOnly>
          <rank>1</rank>
          <nullPolicy>inherit</nullPolicy>
          <presentFlagField/>
        </field_mapping>
        <field_mapping>
          <satelliteName>sat_person_oracle_bvr</satelliteName>
          <sourceFieldName>city</sourceFieldName>
          <targetFieldName>city</targetFieldName>
          <calculationOnly>N</calculationOnly>
          <rank>2</rank>
          <nullPolicy>apply</nullPolicy>
          <presentFlagField/>
        </field_mapping>
        <field_mapping>
          <satelliteName>sat_person_kafka_bvr</satelliteName>
          <sourceFieldName>city</sourceFieldName>
          <targetFieldName>city</targetFieldName>
          <calculationOnly>N</calculationOnly>
          <rank>1</rank>
          <nullPolicy>inherit</nullPolicy>
          <presentFlagField/>
        </field_mapping>
      </field_mappings>
      <satellite_configs>
        <satellite_config>
          <satelliteName>sat_person_oracle_bvr</satelliteName>
          <functionalTimestampField/>
          <sourceIndicatorValue>ORACLE</sourceIndicatorValue>
          <sourceId>ORACLE</sourceId>
          <priorityOverride/>
          <opField/>
        </satellite_config>
        <satellite_config>
          <satelliteName>sat_person_kafka_bvr</satelliteName>
          <functionalTimestampField/>
          <sourceIndicatorValue>KAFKA</sourceIndicatorValue>
          <sourceId>KAFKA</sourceId>
          <priorityOverride/>
          <opField/>
        </satellite_config>
      </satellite_configs>
      <calculations/>
      <calculation_tests/>
      <collapse_tests/>
      <tableName>bv_person_bvr</tableName>
      <description>Survivorship SCD2. Kafka email wins when that feed is inside its calendar window.</description>
      <tableType>SCD2</tableType>
      <derivatives>
        <derivative>
          <dvTableName>hub_person_bvr</dvTableName>
          <dvTableType>HUB</dvTableType>
        </derivative>
        <derivative>
          <dvTableName>sat_person_oracle_bvr</dvTableName>
          <dvTableType>SATELLITE</dvTableType>
        </derivative>
        <derivative>
          <dvTableName>sat_person_kafka_bvr</dvTableName>
          <dvTableType>SATELLITE</dvTableType>
        </derivative>
      </derivatives>
      <source_query_refs/>
      <xloc>800</xloc>
      <yloc>160</yloc>
      <name>bv_person_bvr</name>
    </table>
    <table>
      <parentHubName>hub_person_bvr</parentHubName>
      <sameAsLinkName>lnk_person_same_as_bvr</sameAsLinkName>
      <masterHashField>person_hk</masterHashField>
      <duplicateHashField>person_hk_dup</duplicateHashField>
      <preferredBusinessKeyField/>
      <mdmIdField/>
      <effectivitySatelliteName/>
      <effectivityFromField/>
      <effectivityToField/>
      <unmappedPolicy>self</unmappedPolicy>
      <mapMode>generated</mapMode>
      <tableName>map_person_bvr</tableName>
      <description>Freezes hk_durable on first assignment. A later master change updates hk_master only.</description>
      <tableType>IDENTITY_MAP</tableType>
      <derivatives/>
      <source_query_refs/>
      <xloc>560</xloc>
      <yloc>352</yloc>
      <name>map_person_bvr</name>
    </table>
    <table>
      <entries>
        <entry>
          <sourceId>ORACLE</sourceId>
          <effectiveFrom>1900-01-01</effectiveFrom>
          <effectiveTo>2024-03-01</effectiveTo>
          <priority/>
          <mode>full</mode>
        </entry>
        <entry>
          <sourceId>KAFKA</sourceId>
          <effectiveFrom>2024-03-01</effectiveFrom>
          <effectiveTo/>
          <priority/>
          <mode>delta</mode>
        </entry>
      </entries>
      <tableName>person_sources</tableName>
      <description>Oracle through but not including 2024-03-01. Kafka from that midnight. Kafka nulls are inherited.</description>
      <tableType>SOURCE_CALENDAR</tableType>
      <derivatives/>
      <source_query_refs/>
      <xloc>800</xloc>
      <yloc>352</yloc>
      <name>person_sources</name>
    </table>
  </tables>
  <notes/>
  <dv_references>
    <dv_reference>
      <dvTableName>hub_person_bvr</dvTableName>
      <dvTableType>HUB</dvTableType>
      <xloc>64</xloc>
      <yloc>160</yloc>
    </dv_reference>
    <dv_reference>
      <dvTableName>sat_person_oracle_bvr</dvTableName>
      <dvTableType>SATELLITE</dvTableType>
      <xloc>320</xloc>
      <yloc>64</yloc>
    </dv_reference>
    <dv_reference>
      <dvTableName>sat_person_kafka_bvr</dvTableName>
      <dvTableType>SATELLITE</dvTableType>
      <xloc>320</xloc>
      <yloc>176</yloc>
    </dv_reference>
    <dv_reference>
      <dvTableName>lnk_person_same_as_bvr</dvTableName>
      <dvTableType>LINK</dvTableType>
      <xloc>560</xloc>
      <yloc>224</yloc>
    </dv_reference>
  </dv_references>
  <bv_references/>
  <name>bv-resolution</name>
</business-vault-model>

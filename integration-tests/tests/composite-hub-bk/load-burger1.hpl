<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>load-burger1</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/08/05 12:00:00.000</created_date>
    <modified_date>2026/08/05 12:00:00.000</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>burger_load1.csv</name>
    <filename>${PROJECT_HOME}/files/composite-hub-bk/burger_load1.csv</filename>
    <include_filename>N</include_filename>
    <header>Y</header>
    <separator>,</separator>
    <enclosure/>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <parallel>N</parallel>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field>
        <name>num_seq_bkcc_bk</name>
        <length>10</length>
        <type>String</type>
        <trim_type>none</trim_type>
        <precision>-1</precision>
      </field>
      <field>
        <name>num_seq_bk</name>
        <length>20</length>
        <type>String</type>
        <trim_type>none</trim_type>
        <precision>-1</precision>
      </field>
      <field>
        <name>status</name>
        <length>20</length>
        <type>String</type>
        <trim_type>none</trim_type>
        <precision>-1</precision>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>burger_ext</name>
    <connection>CRM</connection>
    <schema/>
    <table>burger_ext</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <tablename_in_table>Y</tablename_in_table>
    <specify_fields>N</specify_fields>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>80</yloc>
    </GUI>
  </transform>
  <order>
    <hop>
      <from>burger_load1.csv</from>
      <to>burger_ext</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>

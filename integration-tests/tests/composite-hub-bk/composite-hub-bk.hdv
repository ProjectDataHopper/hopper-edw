<data-vault-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Composite hub business key (VaultSpeed-style single vault BK column from two EXT parts)</description>
  <configurationName>data-vault-composite-hub-bk</configurationName>
  <configuration>
    <targetDatabase>Vault</targetDatabase>
    <dataCatalogConnection>local-catalog</dataCatalogConnection>
    <hashAlgorithm>MD5</hashAlgorithm>
    <hashKeyDataType>STRING</hashKeyDataType>
    <generateUnknownRecord>N</generateUnknownRecord>
    <unknownBusinessKeyValue>N/A</unknownBusinessKeyValue>
    <unknownHashKeyValue>00000000000000000000000000000000</unknownHashKeyValue>
    <unknownLinkHashKeyValue>00000000000000000000000000000000</unknownLinkHashKeyValue>
    <unknownRecordSource>UNKNOWN</unknownRecordSource>
    <generateInvalidRecord>N</generateInvalidRecord>
    <invalidBusinessKeyValue>INVALID</invalidBusinessKeyValue>
    <invalidHashKeyValue>FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF</invalidHashKeyValue>
    <invalidLinkHashKeyValue>FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF</invalidLinkHashKeyValue>
    <invalidRecordSource>INVALID</invalidRecordSource>
    <hashContentCasing>NONE</hashContentCasing>
    <businessKeyDelimiter>#</businessKeyDelimiter>
    <hashContentPrefix/>
    <nullPlaceholder>^^</nullPlaceholder>
    <hashContentSuffix>#</hashContentSuffix>
    <trimBusinessKeys>Y</trimBusinessKeys>
    <hashUsesComposedBusinessKey>N</hashUsesComposedBusinessKey>
    <loadDateField>x_load_ts</loadDateField>
    <loadEndDateField/>
    <recordSourceField>x_record_source</recordSourceField>
    <recordSourceFieldLength>100</recordSourceFieldLength>
    <useLoadEndDate>N</useLoadEndDate>
    <generatePrimaryKeys>N</generatePrimaryKeys>
    <generateForeignKeys>N</generateForeignKeys>
    <targetTableBatchSize>1000</targetTableBatchSize>
    <targetTableParallelCopies>${OUTPUT_COPIES}</targetTableParallelCopies>
    <target_load_mode>Table Output</target_load_mode>
    <bulkLoadStagingFolder>${java.io.tmpdir}/dv2/bulk/</bulkLoadStagingFolder>
    <bulkLoadDelimiter>,</bulkLoadDelimiter>
    <bulkLoadEnclosure>"</bulkLoadEnclosure>
    <bulkLoadEncoding>UTF-8</bulkLoadEncoding>
    <bulkLoadLocalFileRequired>N</bulkLoadLocalFileRequired>
    <sortRowsSize>1000000</sortRowsSize>
    <execution_log_level>Minimal</execution_log_level>
    <singleStoreShardKeyOnHashKey>N</singleStoreShardKeyOnHashKey>
    <singleStoreShardKeyIncludeDrivingKeys>N</singleStoreShardKeyIncludeDrivingKeys>
    <hubPipelineNamePrefix>hub-</hubPipelineNamePrefix>
    <linkPipelineNamePrefix>link-</linkPipelineNamePrefix>
    <satellitePipelineNamePrefix>sat-</satellitePipelineNamePrefix>
    <generatedWorkflowNamePrefix>DV Bulk Update - </generatedWorkflowNamePrefix>
    <stsPipelineNamePrefix>sts-</stsPipelineNamePrefix>
  </configuration>
  <coaching>
    <coaching_sources/>
  </coaching>
  <tables>
    <table>
      <businessKeys>
        <name>burger_bk</name>
        <description>Composed business key from EXT parts</description>
        <dataType>String</dataType>
        <length>100</length>
        <composite>Y</composite>
        <sourceFieldNames>
          <sourceFieldName>num_seq_bkcc_bk</sourceFieldName>
          <sourceFieldName>num_seq_bk</sourceFieldName>
        </sourceFieldNames>
        <recordSourceName>CRM-burger-ext</recordSourceName>
      </businessKeys>
      <hashKeyFieldName>burger_hk</hashKeyFieldName>
      <recordSourceFieldName/>
      <recordSources>
        <recordSource>CRM-burger-ext</recordSource>
      </recordSources>
      <tableName>hub_burger</tableName>
      <description>Hub with composite single-column business key</description>
      <tableType>HUB</tableType>
      <integrationMode>HOP_MANAGED</integrationMode>
      <customUpdatePipelinePaths/>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <name>hub_burger</name>
    </table>
    <table>
      <hub>hub_burger</hub>
      <link/>
      <attributes>
        <name>status</name>
        <description>Status attribute from EXT feed</description>
        <dataType>String</dataType>
        <length>20</length>
        <precision/>
        <includeInChangeDataCapture>Y</includeInChangeDataCapture>
      </attributes>
      <parentKeySourceFields>
        <parentKeySourceField>num_seq_bkcc_bk</parentKeySourceField>
        <parentKeySourceField>num_seq_bk</parentKeySourceField>
      </parentKeySourceFields>
      <drivingKey/>
      <recordSource>CRM-burger-ext</recordSource>
      <statusTrackingEnabled>N</statusTrackingEnabled>
      <statusFieldName>record_status</statusFieldName>
      <activeStatusValue>ACTIVE</activeStatusValue>
      <deletedStatusValue>DELETED</deletedStatusValue>
      <tableName>sat_burger</tableName>
      <description>Satellite hashed from composite hub source parts</description>
      <tableType>SATELLITE</tableType>
      <integrationMode>HOP_MANAGED</integrationMode>
      <customUpdatePipelinePaths/>
      <xloc>320</xloc>
      <yloc>64</yloc>
      <name>sat_burger</name>
    </table>
  </tables>
  <notes/>
  <name>composite-hub-bk</name>
</data-vault-model>

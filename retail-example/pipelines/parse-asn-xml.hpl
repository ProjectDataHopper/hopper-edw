<pipeline>
  <info>
    <name>parse-asn-xml</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Flatten Advanced Shipping Notice XML to one row per package line</description>
    <extended_description>
Reads asn_${RETAIL_CSV_WAVE}.xml (or asn_demo.xml when RETAIL_CSV_WAVE=demo).
Output grain: one row per ASN package line for use as a pipeline source feed.
    </extended_description>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>RETAIL_CSV_WAVE</name>
        <default_value>demo</default_value>
        <description>Wave label for ASN file name: demo, initial, 2024-01, …</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/03/22 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/03/22 12:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <height>72</height>
      <xloc>96</xloc>
      <yloc>48</yloc>
      <note>ASN XML → flat package-line feed. Preview on "ASN lines".
Set RETAIL_CSV_WAVE=demo (default) for files/asn_demo.xml,
or initial / 2024-01 after generate-retail-data.py.</note>
      <width>420</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Get ASN package lines</from>
      <to>Add load metadata</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add load metadata</from>
      <to>ASN lines</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Get ASN package lines</name>
    <type>getXMLData</type>
    <description>Loop each Line under ASN/Packages/Package; pull parent attributes via relative XPath</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <IsAFile>N</IsAFile>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <IsInFields>N</IsInFields>
    <XmlField/>
    <addresultfile>N</addresultfile>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <encoding>UTF-8</encoding>
    <extensionFieldName/>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>asn_id</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>String</type>
        <xPath>../../../../@asn_id</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>warehouse_id</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>Integer</type>
        <xPath>../../../../@warehouse_id</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format>yyyy-MM-dd</format>
        <group/>
        <length>-1</length>
        <name>ship_date</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>Date</type>
        <xPath>../../../../@ship_date</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>order_id</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>String</type>
        <xPath>../../../../Order/@order_id</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>customer_id</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>Integer</type>
        <xPath>../../../../Order/@customer_id</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>carrier_code</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>String</type>
        <xPath>../../../../Carrier/@code</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>carrier_service</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>String</type>
        <xPath>../../../../Carrier/@service</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>package_id</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>String</type>
        <xPath>../../@package_id</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>tracking_number</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>String</type>
        <xPath>../../@tracking_number</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>weight_kg</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>Number</type>
        <xPath>../../@weight_kg</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>line_number</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>Integer</type>
        <xPath>@line_number</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>product_id</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>String</type>
        <xPath>@product_id</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>quantity</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>Integer</type>
        <xPath>@quantity</xPath>
      </field>
      <field>
        <currency/>
        <decimal/>
        <element_type>attribut</element_type>
        <format/>
        <group/>
        <length>-1</length>
        <name>unit_price</name>
        <precision>-1</precision>
        <repeat>N</repeat>
        <result_type>valueof</result_type>
        <trim_type>none</trim_type>
        <type>Number</type>
        <xPath>@unit_price</xPath>
      </field>
    </fields>
    <file>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <filemask/>
      <include_subfolders>N</include_subfolders>
      <name>${PROJECT_HOME}/files/asn_${RETAIL_CSV_WAVE}.xml</name>
    </file>
    <hiddenFieldName/>
    <ignorecomments>N</ignorecomments>
    <include>N</include>
    <include_field/>
    <lastModificationTimeFieldName/>
    <limit>0</limit>
    <loopxpath>/AdvancedShipmentNotices/ASN/Packages/Package/Lines/Line</loopxpath>
    <namespaceaware>N</namespaceaware>
    <pathFieldName/>
    <prunePath/>
    <readurl>N</readurl>
    <rootUriNameFieldName/>
    <rownum>N</rownum>
    <rownum_field/>
    <shortFileFieldName/>
    <sizeFieldName/>
    <uriNameFieldName/>
    <usetoken>N</usetoken>
    <validating>N</validating>
    <attributes/>
    <GUI>
      <xloc>192</xloc>
      <yloc>176</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Add load metadata</name>
    <type>Constant</type>
    <description>record_source constant for catalog / vault binding demos</description>
    <fields>
      <field>
        <nullif>E2E-asn-line</nullif>
        <name>record_source</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>448</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <name>ASN lines</name>
    <type>Dummy</type>
    <description>Published output transform for pipeline-source / preview</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>688</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>

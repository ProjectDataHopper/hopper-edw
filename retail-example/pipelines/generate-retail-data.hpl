<pipeline>
  <info>
    <name>generate-retail-data</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Seeded retail source files. Replaces scripts/generate-retail-data.py.</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>MODE</name>
        <default_value>initial</default_value>
        <description>initial or update</description>
      </parameter>
      <parameter>
        <name>SEED</name>
        <default_value>42</default_value>
        <description>Random seed</description>
      </parameter>
      <parameter>
        <name>CUSTOMERS</name>
        <default_value>10000</default_value>
        <description>Customer population</description>
      </parameter>
      <parameter>
        <name>PRODUCTS</name>
        <default_value>1000</default_value>
        <description>Product population</description>
      </parameter>
      <parameter>
        <name>ORDERS</name>
        <default_value>100000</default_value>
        <description>Order population</description>
      </parameter>
      <parameter>
        <name>WAREHOUSES</name>
        <default_value>50</default_value>
        <description>Warehouse population</description>
      </parameter>
      <parameter>
        <name>SALES_REPS</name>
        <default_value>25</default_value>
        <description>Sales rep population</description>
      </parameter>
      <parameter>
        <name>WAVE_INDEX</name>
        <default_value>1</default_value>
        <description>Finished loads already in retail_load_log. The first update is 1.</description>
      </parameter>
      <parameter>
        <name>RETAIL_CSV_WAVE</name>
        <default_value>initial</default_value>
        <description>File suffix: initial, or yyyy-MM</description>
      </parameter>
      <parameter>
        <name>LOAD_DATE</name>
        <default_value>2024/01/01 00:00:00.000</default_value>
        <description>Load date for this run, yyyy/MM/dd HH:mm:ss.SSS</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <created_user>-</created_user>
    <created_date>2026/09/21 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/21 12:00:00.000</modified_date>
  </info>
  <transform>
    <type>SyntheticData</type>
    <name>Customers hub</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+1</seed>
    <cardinalityMode>COMBINE</cardinalityMode>
    <populations>
      <population>
        <kind>RANGE</kind>
        <start>ifEq('${MODE}','initial',1,${CUSTOMERS}+(max(1,${WAVE_INDEX})-1)*max(50,div(${CUSTOMERS},100))+1)</start>
        <count>ifEq('${MODE}','initial',${CUSTOMERS},max(50,div(${CUSTOMERS},100)))</count>
      </population>
    </populations>
    <fields>
      <field>
        <name>customer_id</name>
        <hopType>Integer</hopType>
        <generator>SEQUENCE</generator>
        <arguments>source=population</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-customer-hub</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>64</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Customer demo</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+2</seed>
    <cardinalityMode>COMBINE</cardinalityMode>
    <populations>
      <population>
        <kind>SAMPLE</kind>
        <from>1</from>
        <to>${CUSTOMERS}</to>
        <count>ifEq('${MODE}','initial',0,max(50,div(${CUSTOMERS},100)))</count>
      </population>
      <population>
        <kind>RANGE</kind>
        <start>ifEq('${MODE}','initial',1,${CUSTOMERS}+(max(1,${WAVE_INDEX})-1)*max(50,div(${CUSTOMERS},100))+1)</start>
        <count>ifEq('${MODE}','initial',${CUSTOMERS},max(50,div(${CUSTOMERS},100)))</count>
      </population>
    </populations>
    <fields>
      <field>
        <name>customer_id</name>
        <hopType>Integer</hopType>
        <generator>SEQUENCE</generator>
        <arguments>source=population</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>segment</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=RETAIL|WHOLESALE|ONLINE</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>loyalty_tier</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=BRONZE|SILVER|GOLD|PLATINUM</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>demo_score</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=40;max=99</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-customer-demo</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>160</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Customer contact</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+3</seed>
    <cardinalityMode>COMBINE</cardinalityMode>
    <populations>
      <population>
        <kind>SAMPLE</kind>
        <from>1</from>
        <to>${CUSTOMERS}</to>
        <count>ifEq('${MODE}','initial',0,max(50,div(${CUSTOMERS},100)))</count>
      </population>
      <population>
        <kind>RANGE</kind>
        <start>ifEq('${MODE}','initial',1,${CUSTOMERS}+(max(1,${WAVE_INDEX})-1)*max(50,div(${CUSTOMERS},100))+1)</start>
        <count>ifEq('${MODE}','initial',${CUSTOMERS},max(50,div(${CUSTOMERS},100)))</count>
      </population>
    </populations>
    <fields>
      <field>
        <name>customer_id</name>
        <hopType>Integer</hopType>
        <generator>SEQUENCE</generator>
        <arguments>source=population</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>email</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=customer${customer_id}@example.com</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>phone</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=+1-555-${pad(mod(customer_id,10000),4)}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-customer-contact</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>256</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Customer address</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+4</seed>
    <cardinalityMode>COMBINE</cardinalityMode>
    <populations>
      <population>
        <kind>SAMPLE</kind>
        <from>1</from>
        <to>${CUSTOMERS}</to>
        <count>ifEq('${MODE}','initial',0,max(50,div(${CUSTOMERS},100)))</count>
      </population>
      <population>
        <kind>RANGE</kind>
        <start>ifEq('${MODE}','initial',1,${CUSTOMERS}+(max(1,${WAVE_INDEX})-1)*max(50,div(${CUSTOMERS},100))+1)</start>
        <count>ifEq('${MODE}','initial',${CUSTOMERS},max(50,div(${CUSTOMERS},100)))</count>
      </population>
    </populations>
    <fields>
      <field>
        <name>customer_id</name>
        <hopType>Integer</hopType>
        <generator>SEQUENCE</generator>
        <arguments>source=population</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>address_line1</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=${100+mod(customer_id,900)} Market Street</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>city</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=New York|Chicago|Phoenix|Seattle|Austin</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>postal_code</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=${10000+mod(customer_id,900)}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-customer-address</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>352</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Customer prefs</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+5</seed>
    <cardinalityMode>COMBINE</cardinalityMode>
    <populations>
      <population>
        <kind>SAMPLE</kind>
        <from>1</from>
        <to>${CUSTOMERS}</to>
        <count>ifEq('${MODE}','initial',0,max(50,div(${CUSTOMERS},100)))</count>
      </population>
      <population>
        <kind>RANGE</kind>
        <start>ifEq('${MODE}','initial',1,${CUSTOMERS}+(max(1,${WAVE_INDEX})-1)*max(50,div(${CUSTOMERS},100))+1)</start>
        <count>ifEq('${MODE}','initial',${CUSTOMERS},max(50,div(${CUSTOMERS},100)))</count>
      </population>
    </populations>
    <fields>
      <field>
        <name>customer_id</name>
        <hopType>Integer</hopType>
        <generator>SEQUENCE</generator>
        <arguments>source=population</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>newsletter_opt_in</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=Y|N</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>preferred_channel</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=EMAIL|SMS|PHONE</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>language_code</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=en|fr|de|es</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-customer-prefs</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>448</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Products</name>
    <description/>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+6</seed>
    <cardinalityMode>COMBINE</cardinalityMode>
    <populations>
      <population>
        <kind>RANGE</kind>
        <start>ifEq('${MODE}','initial',1,${PRODUCTS}+(max(1,${WAVE_INDEX})-1)*max(50,div(${PRODUCTS},100))+1)</start>
        <count>ifEq('${MODE}','initial',${PRODUCTS},max(50,div(${PRODUCTS},100)))</count>
      </population>
    </populations>
    <fields>
      <field>
        <name>product_id</name>
        <hopType>String</hopType>
        <generator>SEQUENCE</generator>
        <arguments>source=population;format=P%06d</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>product_name</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=Product ${population_id}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>category</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=Electronics|Apparel|Home|Sports|Grocery</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>unit_price</name>
        <hopType>Number</hopType>
        <generator>NUMBER_RANGE</generator>
        <arguments>min=5;max=499.99;scale=2</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-product</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>544</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Warehouses</name>
    <description/>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+7</seed>
    <cardinalityMode>COMBINE</cardinalityMode>
    <populations>
      <population>
        <kind>RANGE</kind>
        <start>ifEq('${MODE}','initial',1,${WAREHOUSES}+(max(1,${WAVE_INDEX})-1)*max(50,div(${WAREHOUSES},100))+1)</start>
        <count>ifEq('${MODE}','initial',${WAREHOUSES},max(50,div(${WAREHOUSES},100)))</count>
      </population>
    </populations>
    <fields>
      <field>
        <name>warehouse_id</name>
        <hopType>Integer</hopType>
        <generator>SEQUENCE</generator>
        <arguments>source=population</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>warehouse_name</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=Warehouse ${population_id}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>city</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=New York|Chicago|Phoenix|Seattle|Austin</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>region</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=North|South|East|West</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>capacity</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=10000;max=250000</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-warehouse</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>640</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Sales reps</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+8</seed>
    <cardinalityMode>COUNT</cardinalityMode>
    <rowCount>ifEq('${MODE}','initial',max(5,${SALES_REPS}),0)</rowCount>
    <fields>
      <field>
        <name>rep_id</name>
        <hopType>Integer</hopType>
        <generator>SEQUENCE</generator>
        <arguments>start=101;step=1</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>rep_name</name>
        <hopType>String</hopType>
        <generator>LOOKUP</generator>
        <arguments>keyField=rep_id;entries=101:Ada Lovelace|102:Grace Hopper|103:Alan Turing|104:Katherine Johnson|105:Donald Knuth;fallback=Sales Rep ${rep_id}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>region</name>
        <hopType>String</hopType>
        <generator>LOOKUP</generator>
        <arguments>keyField=rep_id;entries=101:NORTH|102:SOUTH|103:EAST|104:WEST|105:CENTRAL;fallbackGenerator=CHOICE;fallbackValues=NORTH|SOUTH|EAST|WEST|CENTRAL</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-sales-rep</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>736</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Order headers</name>
    <description/>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+9</seed>
    <cardinalityMode>COMBINE</cardinalityMode>
    <populations>
      <population>
        <kind>RANGE</kind>
        <start>ifEq('${MODE}','initial',1,${ORDERS}+(max(1,${WAVE_INDEX})-1)*max(50,div(${ORDERS},100))+1)</start>
        <count>ifEq('${MODE}','initial',${ORDERS},max(50,div(${ORDERS},100)))</count>
      </population>
    </populations>
    <fields>
      <field>
        <name>order_id</name>
        <hopType>String</hopType>
        <generator>SEQUENCE</generator>
        <arguments>source=population;format=O%06d</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>customer_id</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=1;max=ifEq('${MODE}','initial',${CUSTOMERS},${CUSTOMERS}+max(1,${WAVE_INDEX})*max(50,div(${CUSTOMERS},100)))</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>order_date</name>
        <hopType>String</hopType>
        <generator>DATE_OFFSET</generator>
        <arguments>base=${LOAD_DATE};minDays=0;maxDays=27;format=yyyy-MM-dd</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>shipping_date</name>
        <hopType>String</hopType>
        <generator>DATE_OFFSET</generator>
        <arguments>base=order_date;minDays=1;maxDays=3;format=yyyy-MM-dd</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>delivery_date</name>
        <hopType>String</hopType>
        <generator>DATE_OFFSET</generator>
        <arguments>base=shipping_date;minDays=1;maxDays=5;format=yyyy-MM-dd</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>order_status</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=NEW|SHIPPED|DELIVERED|CANCELLED</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>total_amount</name>
        <hopType>Number</hopType>
        <generator>NUMBER_RANGE</generator>
        <arguments>min=25;max=2500;scale=2</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-order-header</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>832</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Order lines</name>
    <description/>
    <distribute>N</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+10</seed>
    <cardinalityMode>PER_PARENT</cardinalityMode>
    <fraction>1</fraction>
    <includeFirst>Y</includeFirst>
    <minRows>0</minRows>
    <minChildren>1</minChildren>
    <maxChildren>4</maxChildren>
    <parentsTransform>Order headers</parentsTransform>
    <fields>
      <field>
        <name>order_id</name>
        <hopType>String</hopType>
        <generator>COPY</generator>
        <arguments>field=parent.order_id</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>product_num</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=1;max=ifEq('${MODE}','initial',${PRODUCTS},${PRODUCTS}+max(1,${WAVE_INDEX})*max(50,div(${PRODUCTS},100)));repeatPreviousProbability=0.25</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>product_id</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=P${pad(product_num,6)}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>line_number</name>
        <hopType>Integer</hopType>
        <generator>SEQUENCE_IN_PARENT</generator>
        <arguments>start=1</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>quantity</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=1;max=5</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>unit_price</name>
        <hopType>Number</hopType>
        <generator>NUMBER_RANGE</generator>
        <arguments>min=5;max=499.99;scale=2</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>discount_pct</name>
        <hopType>Number</hopType>
        <generator>NUMBER_RANGE</generator>
        <arguments>min=0;max=0.25;scale=2</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-order-line</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <overrides>
      <override>
        <parentIndex>0</parentIndex>
        <parentOp>=</parentOp>
        <forceChildCount>3</forceChildCount>
      </override>
      <override>
        <parentIndex>0</parentIndex>
        <parentOp>=</parentOp>
        <childIndex>1</childIndex>
        <childOp>=</childOp>
        <field>product_num</field>
        <generator>COPY_SIBLING</generator>
        <arguments>child=0</arguments>
      </override>
      <override>
        <parentIndex>0</parentIndex>
        <parentOp>=</parentOp>
        <childIndex>2</childIndex>
        <childOp>=</childOp>
        <field>product_num</field>
        <generator>INT_RANGE</generator>
        <arguments>min=1;max=ifEq('${MODE}','initial',${PRODUCTS},${PRODUCTS}+max(1,${WAVE_INDEX})*max(50,div(${PRODUCTS},100)));excludeSibling=0</arguments>
      </override>
      <override>
        <parentIndex>0</parentIndex>
        <parentOp>=</parentOp>
        <childIndex>1</childIndex>
        <childOp>&lt;=</childOp>
        <field>unit_price</field>
        <generator>NUMBER_EXPR</generator>
        <arguments>expression=4+(${child_index}+1)*0.5;scale=2</arguments>
      </override>
      <override>
        <parentIndex>0</parentIndex>
        <parentOp>=</parentOp>
        <childIndex>1</childIndex>
        <childOp>&lt;=</childOp>
        <field>discount_pct</field>
        <generator>NUMBER_EXPR</generator>
        <arguments>expression=0.05*(${child_index}+1);scale=2</arguments>
      </override>
    </overrides>
    <GUI>
      <xloc>80</xloc>
      <yloc>928</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Shipment events</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+11+ifEq('${MODE}','initial',0,${WAVE_INDEX})</seed>
    <cardinalityMode>PATHS</cardinalityMode>
    <fraction>0.4</fraction>
    <includeFirst>Y</includeFirst>
    <minRows>1</minRows>
    <selectorField>order_status</selectorField>
    <parentsTransform>Order headers</parentsTransform>
    <paths>
      <path>
        <when>CANCELLED</when>
        <probability>0.5</probability>
        <steps>EXCEPTION</steps>
      </path>
      <path>
        <when>DELIVERED</when>
        <steps>LABEL_CREATED|PICKED_UP|IN_TRANSIT|OUT_FOR_DELIVERY|DELIVERED</steps>
      </path>
      <path>
        <when>SHIPPED</when>
        <steps>LABEL_CREATED|PICKED_UP|IN_TRANSIT</steps>
        <extraStep>OUT_FOR_DELIVERY</extraStep>
        <extraProbability>0.35</extraProbability>
      </path>
      <path>
        <when>NEW</when>
        <probability>0.4</probability>
        <steps>LABEL_CREATED</steps>
        <elseSteps>LABEL_CREATED|PICKED_UP</elseSteps>
      </path>
      <path>
        <when>*</when>
        <probability>0.1</probability>
        <steps>LABEL_CREATED|PICKED_UP|EXCEPTION</steps>
        <elseSteps>LABEL_CREATED|PICKED_UP|IN_TRANSIT</elseSteps>
      </path>
    </paths>
    <fields>
      <field>
        <name>event_date</name>
        <hopType>String</hopType>
        <generator>DATE_OFFSET</generator>
        <arguments>base=parent.order_date;daysExpr=ifEq(step_name,'LABEL_CREATED',0,ifEq(step_name,'PICKED_UP',dateDiff(parent.shipping_date,parent.order_date),ifEq(step_name,'DELIVERED',dateDiff(parent.delivery_date,parent.order_date),dateDiff(parent.shipping_date,parent.order_date)+div(dateDiff(parent.delivery_date,parent.shipping_date),2)+min(step_index,2))));format=yyyy-MM-dd</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>hour</name>
        <hopType>Integer</hopType>
        <generator>NUMBER_EXPR</generator>
        <arguments>expression=8+mod(step_index*3,12)</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>minute</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=0;max=59</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>status_ts</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=${event_date}T${pad(hour,2)}:${pad(minute,2)}:00Z</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>city</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=Columbus|Memphis|Louisville|Chicago|Atlanta|Dallas|Denver|Seattle</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>region</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=North|South|East|West</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>carrier</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=UPS|FEDEX|USPS|DHL;scope=parent</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>track_a</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=100000;max=999999;scope=parent</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>track_b</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=10000000;max=99999999;scope=parent</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>tracking</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=1Z${pad(track_a,6)}${pad(track_b,8)};scope=parent</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>warehouse_id</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=1;max=ifEq('${MODE}','initial',${WAREHOUSES},${WAREHOUSES}+max(1,${WAVE_INDEX})*max(50,div(${WAREHOUSES},100)));scope=parent</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>notes</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=Status update: ${label(step_name)}</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>message_id</name>
        <hopType>String</hopType>
        <generator>UUID</generator>
        <arguments></arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>payload</name>
        <hopType>String</hopType>
        <generator>JSON</generator>
        <arguments>order_id=${parent.order_id};tracking_number=${tracking};carrier=${carrier};status=${step_name};status_ts=${status_ts};location.city=${city};location.region=${region};warehouse_id=${warehouse_id};notes=${notes}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>kafka_timestamp</name>
        <hopType>String</hopType>
        <generator>COPY</generator>
        <arguments>field=event_date</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>topic</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=retail.order.shipment</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>partition</name>
        <hopType>Integer</hopType>
        <generator>MOD_HASH</generator>
        <arguments>field=parent.order_id;divisor=8</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>offset</name>
        <hopType>Integer</hopType>
        <generator>SEQUENCE_IN_GROUP</generator>
        <arguments>groupField=partition;start=0</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-order-shipment-event</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>1024</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Order reps</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+12</seed>
    <cardinalityMode>PER_PARENT</cardinalityMode>
    <fraction>1</fraction>
    <includeFirst>Y</includeFirst>
    <minChildren>1</minChildren>
    <maxChildren>1</maxChildren>
    <parentsTransform>Order headers</parentsTransform>
    <fields>
      <field>
        <name>order_id</name>
        <hopType>String</hopType>
        <generator>COPY</generator>
        <arguments>field=parent.order_id</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>primary_rep_id</name>
        <hopType>Integer</hopType>
        <generator>REFERENCE</generator>
        <arguments>min=101;max=101+max(5,${SALES_REPS})-1</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>secondary_rep_id</name>
        <hopType>Integer</hopType>
        <generator>REFERENCE</generator>
        <arguments>min=101;max=101+max(5,${SALES_REPS})-1;excludeField=primary_rep_id</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-order-rep</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>1120</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>Warehouse product</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+13</seed>
    <cardinalityMode>UNIQUE_PAIRS</cardinalityMode>
    <pairCount>ifEq('${MODE}','initial',min(5000,${WAREHOUSES}*20),min(500,max(50,div(${WAREHOUSES},100))*max(50,div(${PRODUCTS},100))))</pairCount>
    <pairLeftField>warehouse_id</pairLeftField>
    <pairRightField>product_id</pairRightField>
    <pairsLeftTransform>Warehouses</pairsLeftTransform>
    <pairsRightTransform>Products</pairsRightTransform>
    <fields>
      <field>
        <name>warehouse_id</name>
        <hopType>Integer</hopType>
        <generator>COPY</generator>
        <arguments>field=pair_left</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>product_id</name>
        <hopType>String</hopType>
        <generator>COPY</generator>
        <arguments>field=pair_right</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>stock_qty</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=0;max=5000</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>reorder_point</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=50;max=500</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>load_date</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=${LOAD_DATE}</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>record_source</name>
        <hopType>String</hopType>
        <generator>CONSTANT</generator>
        <arguments>value=E2E-warehouse-product</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>1216</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>SyntheticData</type>
    <name>ASN lines</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <seed>${SEED}+14</seed>
    <cardinalityMode>HIERARCHY</cardinalityMode>
    <fraction>0.35</fraction>
    <includeFirst>Y</includeFirst>
    <minRows>1</minRows>
    <selectorField>order_status</selectorField>
    <includeStatuses>SHIPPED|DELIVERED</includeStatuses>
    <fallbackStatuses>NEW</fallbackStatuses>
    <parentKey>order_id</parentKey>
    <childKey>order_id</childKey>
    <splitMinChildren>3</splitMinChildren>
    <splitProbability>0.35</splitProbability>
    <parentsTransform>Order headers</parentsTransform>
    <childrenTransform>Order lines</childrenTransform>
    <documentFormat>XML</documentFormat>
    <documentFilename>${PROJECT_HOME}/files/asn_${RETAIL_CSV_WAVE}.xml</documentFilename>
    <documentRootElement>AdvancedShipmentNotices</documentRootElement>
    <documentRootAttributes>wave=${RETAIL_CSV_WAVE};generated_at=${LOAD_DATE}</documentRootAttributes>
    <documentEncoding>UTF-8</documentEncoding>
    <fields>
      <field>
        <name>asn_id</name>
        <hopType>String</hopType>
        <generator>SEQUENCE</generator>
        <arguments>source=group;format=ASN%06d</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>warehouse_id</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=1;max=ifEq('${MODE}','initial',${WAREHOUSES},${WAREHOUSES}+max(1,${WAVE_INDEX})*max(50,div(${WAREHOUSES},100)));scope=parent</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>ship_date</name>
        <hopType>String</hopType>
        <generator>COPY</generator>
        <arguments>field=parent.shipping_date</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>order_id</name>
        <hopType>String</hopType>
        <generator>COPY</generator>
        <arguments>field=parent.order_id</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>customer_id</name>
        <hopType>Integer</hopType>
        <generator>COPY</generator>
        <arguments>field=parent.customer_id</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>carrier_code</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=UPS|FEDEX|USPS|DHL;scope=parent</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>carrier_service</name>
        <hopType>String</hopType>
        <generator>CHOICE</generator>
        <arguments>values=GROUND|PRIORITY|EXPRESS|OVERNIGHT;scope=parent</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>package_id</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=PKG-${package_index};scope=package</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>track_a</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=100000;max=999999;scope=package</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>track_b</name>
        <hopType>Integer</hopType>
        <generator>INT_RANGE</generator>
        <arguments>min=10000000;max=99999999;scope=package</arguments>
        <publish>N</publish>
      </field>
      <field>
        <name>tracking_number</name>
        <hopType>String</hopType>
        <generator>TEMPLATE</generator>
        <arguments>pattern=1Z${pad(track_a,6)}${pad(track_b,8)};scope=package</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>weight_kg</name>
        <hopType>Number</hopType>
        <generator>CHILD_AGGREGATE</generator>
        <arguments>childField=quantity;factorMin=0.15;factorMax=0.45;scale=2;scope=package</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>line_number</name>
        <hopType>Integer</hopType>
        <generator>COPY</generator>
        <arguments>field=child.line_number</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>product_id</name>
        <hopType>String</hopType>
        <generator>COPY</generator>
        <arguments>field=child.product_id</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>quantity</name>
        <hopType>Integer</hopType>
        <generator>COPY</generator>
        <arguments>field=child.quantity</arguments>
        <publish>Y</publish>
      </field>
      <field>
        <name>unit_price</name>
        <hopType>Number</hopType>
        <generator>COPY</generator>
        <arguments>field=child.unit_price</arguments>
        <publish>Y</publish>
      </field>
    </fields>
    <xmlNodes>
      <xmlNode>
        <id>asn</id>
        <parentId></parentId>
        <nodeType>GROUP</nodeType>
        <element>ASN</element>
        <groupField>asn_id</groupField>
        <attributes>asn_id:asn_id,warehouse_id:warehouse_id,ship_date:ship_date</attributes>
      </xmlNode>
      <xmlNode>
        <id>order</id>
        <parentId>asn</parentId>
        <nodeType>ELEMENT</nodeType>
        <element>Order</element>
        <groupField></groupField>
        <attributes>order_id:order_id,customer_id:customer_id</attributes>
      </xmlNode>
      <xmlNode>
        <id>carrier</id>
        <parentId>asn</parentId>
        <nodeType>ELEMENT</nodeType>
        <element>Carrier</element>
        <groupField></groupField>
        <attributes>code:carrier_code,service:carrier_service</attributes>
      </xmlNode>
      <xmlNode>
        <id>packages</id>
        <parentId>asn</parentId>
        <nodeType>WRAPPER</nodeType>
        <element>Packages</element>
        <groupField></groupField>
        <attributes></attributes>
      </xmlNode>
      <xmlNode>
        <id>package</id>
        <parentId>packages</parentId>
        <nodeType>GROUP</nodeType>
        <element>Package</element>
        <groupField>package_id</groupField>
        <attributes>package_id:package_id,tracking_number:tracking_number,weight_kg:weight_kg</attributes>
      </xmlNode>
      <xmlNode>
        <id>lines</id>
        <parentId>package</parentId>
        <nodeType>WRAPPER</nodeType>
        <element>Lines</element>
        <groupField></groupField>
        <attributes></attributes>
      </xmlNode>
      <xmlNode>
        <id>line</id>
        <parentId>lines</parentId>
        <nodeType>ROW</nodeType>
        <element>Line</element>
        <groupField></groupField>
        <attributes>line_number:line_number,product_id:product_id,quantity:quantity,unit_price:unit_price</attributes>
      </xmlNode>
    </xmlNodes>
    <GUI>
      <xloc>80</xloc>
      <yloc>1312</yloc>
    </GUI>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>Write customer hub</name>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${PROJECT_HOME}/files/customer_hub_${RETAIL_CSV_WAVE}.csv</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extension/>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>

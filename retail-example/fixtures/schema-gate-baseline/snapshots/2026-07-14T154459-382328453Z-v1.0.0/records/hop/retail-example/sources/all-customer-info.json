    "compositeSourceQueryName" : "all-customer-info",
    "compositeGeneratedSql" : "SELECT customer_hub.customer_id AS customer_id, customer_add.address_line1 AS address_line1, customer_add.city AS city, customer_add.postal_code AS postal_code, customer_con.email AS email, customer_con.phone AS phone, customer_dem.segment AS segment, customer_dem.loyalty_tier AS loyalty_tier, customer_dem.demo_score AS demo_score, customer_pre.newsletter_opt_in AS newsletter_opt_in, customer_pre.preferred_channel AS preferred_channel, customer_pre.language_code AS language_code FROM \"public\".customer_hub customer_hub LEFT OUTER JOIN \"public\".customer_demo customer_dem ON customer_hub.customer_id = customer_dem.customer_id LEFT OUTER JOIN \"public\".customer_address customer_add ON customer_hub.customer_id = customer_add.customer_id LEFT OUTER JOIN \"public\".customer_prefs customer_pre ON customer_hub.customer_id = customer_pre.customer_id LEFT OUTER JOIN \"public\".customer_contact customer_con ON customer_hub.customer_id = customer_con.customer_id"

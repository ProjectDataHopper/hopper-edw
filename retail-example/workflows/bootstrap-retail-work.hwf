<workflow>
  <name>bootstrap-retail-work</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Create the gitignored work/ tree, copy catalog sources, and seed catalog version v1.0.0 when it is missing.</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/21 22:30:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/21 22:30:00.000</modified_date>
  <parameters>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create reports folder</name>
      <description>work/reports</description>
      <type>CREATE_FOLDER</type>
      <attributes/>
      <fail_of_folder_exists>N</fail_of_folder_exists>
      <foldername>${PROJECT_HOME}/work/reports</foldername>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create execution-maps folder</name>
      <description>work/execution-maps</description>
      <type>CREATE_FOLDER</type>
      <attributes/>
      <fail_of_folder_exists>N</fail_of_folder_exists>
      <foldername>${PROJECT_HOME}/work/execution-maps</foldername>
      <parallel>N</parallel>
      <xloc>416</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create metrics folder</name>
      <description>work/metrics</description>
      <type>CREATE_FOLDER</type>
      <attributes/>
      <fail_of_folder_exists>N</fail_of_folder_exists>
      <foldername>${PROJECT_HOME}/work/metrics</foldername>
      <parallel>N</parallel>
      <xloc>608</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Create catalog sources folder</name>
      <description>work/edw-catalog/hop/retail-example/sources</description>
      <type>CREATE_FOLDER</type>
      <attributes/>
      <fail_of_folder_exists>N</fail_of_folder_exists>
      <foldername>${PROJECT_HOME}/work/edw-catalog/hop/retail-example/sources</foldername>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>64</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Copy E2E catalog sources</name>
      <description>Overwrite E2E-*.json from fixtures/catalog-sources. The feeds/ subfolder is not included.</description>
      <type>COPY_FILES</type>
      <attributes/>
      <copy_empty_folders>N</copy_empty_folders>
      <arg_from_previous>N</arg_from_previous>
      <overwrite_files>Y</overwrite_files>
      <include_subfolders>N</include_subfolders>
      <remove_source_files>N</remove_source_files>
      <add_result_filesname>N</add_result_filesname>
      <destination_is_a_file>N</destination_is_a_file>
      <create_destination_folder>Y</create_destination_folder>
      <fields>
        <field>
          <source_filefolder>${PROJECT_HOME}/fixtures/catalog-sources</source_filefolder>
          <destination_filefolder>${PROJECT_HOME}/work/edw-catalog/hop/retail-example/sources</destination_filefolder>
          <wildcard/>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>224</xloc>
      <yloc>208</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Copy model feeds</name>
      <description>Seed all-customer-info, asn-package-lines, and feed_order_shipment_tracking only when missing.</description>
      <type>COPY_FILES</type>
      <attributes/>
      <copy_empty_folders>N</copy_empty_folders>
      <arg_from_previous>N</arg_from_previous>
      <overwrite_files>N</overwrite_files>
      <include_subfolders>N</include_subfolders>
      <remove_source_files>N</remove_source_files>
      <add_result_filesname>N</add_result_filesname>
      <destination_is_a_file>N</destination_is_a_file>
      <create_destination_folder>Y</create_destination_folder>
      <fields>
        <field>
          <source_filefolder>${PROJECT_HOME}/fixtures/catalog-sources/feeds</source_filefolder>
          <destination_filefolder>${PROJECT_HOME}/work/edw-catalog/hop/retail-example/sources</destination_filefolder>
          <wildcard/>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>448</xloc>
      <yloc>208</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Catalog baseline exists</name>
      <description>True when work/edw-catalog/catalog-versions/versions.json is already present.</description>
      <type>FILE_EXISTS</type>
      <attributes/>
      <filename>${PROJECT_HOME}/work/edw-catalog/catalog-versions/versions.json</filename>
      <parallel>N</parallel>
      <xloc>656</xloc>
      <yloc>208</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Copy schema-gate baseline</name>
      <description>Copy fixtures/schema-gate-baseline into work/edw-catalog/catalog-versions.</description>
      <type>COPY_FILES</type>
      <attributes/>
      <copy_empty_folders>Y</copy_empty_folders>
      <arg_from_previous>N</arg_from_previous>
      <overwrite_files>Y</overwrite_files>
      <include_subfolders>Y</include_subfolders>
      <remove_source_files>N</remove_source_files>
      <add_result_filesname>N</add_result_filesname>
      <destination_is_a_file>N</destination_is_a_file>
      <create_destination_folder>Y</create_destination_folder>
      <fields>
        <field>
          <source_filefolder>${PROJECT_HOME}/fixtures/schema-gate-baseline</source_filefolder>
          <destination_filefolder>${PROJECT_HOME}/work/edw-catalog/catalog-versions</destination_filefolder>
          <wildcard/>
        </field>
      </fields>
      <parallel>N</parallel>
      <xloc>864</xloc>
      <yloc>208</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create reports folder</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create reports folder</from>
      <to>Create execution-maps folder</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Create execution-maps folder</from>
      <to>Create metrics folder</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Create metrics folder</from>
      <to>Create catalog sources folder</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Create catalog sources folder</from>
      <to>Copy E2E catalog sources</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Copy E2E catalog sources</from>
      <to>Copy model feeds</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Copy model feeds</from>
      <to>Catalog baseline exists</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Catalog baseline exists</from>
      <to>Copy schema-gate baseline</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

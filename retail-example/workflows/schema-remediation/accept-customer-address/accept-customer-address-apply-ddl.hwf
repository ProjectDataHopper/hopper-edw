<workflow>
  <name>accept-customer-address-apply-ddl</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/08/02 14:14:14.577</created_date>
  <modified_date>2026/08/02 14:14:14.577</modified_date>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>50</xloc>
      <yloc>100</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>CREATE TABLE sat_customer_address
(
customer_hk VARCHAR(63)
,
address_line1 VARCHAR(75)
,
city VARCHAR(50)
,
postal_code VARCHAR(10)
,
x_record_source VARCHAR(100)
,
x_load_ts TIMESTAMP
,
PRIMARY KEY (customer_hk, x_load_ts),
CONSTRAINT fk_sat_customer_address_hub_customer FOREIGN KEY (customer_hk) REFERENCES hub_customer (customer_hk))
;
</sql>
      <connection>Vault</connection>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>N</sendOneStatement>
      <name>DDL sat_customer_address</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <xloc>250</xloc>
      <yloc>100</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <xloc>450</xloc>
      <yloc>100</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>DDL sat_customer_address</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DDL sat_customer_address</from>
      <to>Success</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

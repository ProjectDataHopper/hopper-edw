      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>50</xloc>
      <yloc>100</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <sql>CREATE TABLE sat_customer_contact
(
customer_hk VARCHAR(63)
,
email VARCHAR(50)
,
phone VARCHAR(20)
,
x_record_source VARCHAR(100)
,
x_load_ts TIMESTAMP
,
PRIMARY KEY (customer_hk, x_load_ts),
CONSTRAINT fk_sat_customer_contact_hub_customer FOREIGN KEY (customer_hk) REFERENCES hub_customer (customer_hk))
;
</sql>
      <connection>Vault</connection>
      <useVariableSubstitution>Y</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sendOneStatement>N</sendOneStatement>
      <name>DDL sat_customer_contact</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <xloc>250</xloc>
      <yloc>100</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <xloc>450</xloc>
      <yloc>100</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>DDL sat_customer_contact</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DDL sat_customer_contact</from>

      <historyDatabase>OPS</historyDatabase>
      <historySchema>dv_ops</historySchema>
      <loadId>${DV_WORKFLOW_EXECUTION_ID}</loadId>
      <autoCreateTables>Y</autoCreateTables>
      <publishCatalogDefinitions>Y</publishCatalogDefinitions>
      <failOnPersistError>N</failOnPersistError>

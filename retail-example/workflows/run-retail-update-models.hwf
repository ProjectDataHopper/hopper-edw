<workflow>
  <name>run-retail-update-models</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/07/10 12:35:36.188</created_date>
  <modified_date>2026/07/10 12:35:36.188</modified_date>
  <workflow_version/>
  <parameters>
    <parameter>
      <name>DV_ACTUAL_LOAD_DATE</name>
      <description>Load date for incremental Data Vault Update actions</description>
      <default_value>2024/02/01 00:00:00.000</default_value>
    </parameter>
    <parameter>
      <name>OUTPUT_COPIES</name>
      <description>Valid in the current workflow</description>
      <default_value>1</default_value>
    </parameter>
    <parameter>
      <name>METRICS_FOLDER</name>
      <description>Valid in the current workflow</description>
      <default_value>${PROJECT_HOME}/work/metrics</default_value>
    </parameter>
    <parameter>
      <name>PIPELINE_COPIES</name>
      <description>Valid in the current workflow</description>
      <default_value>3</default_value>
    </parameter>
    <parameter>
      <name>EXPECT_AUTOMATIC_TARGET_TABLE_CREATION</name>
      <description>Y on initial load (missing target tables are not reported; vault update creates them). N on update runs so missing/altered targets fail fail-on-warnings.</description>
      <default_value>N</default_value>
    </parameter>
    <parameter>
      <name>REPORT_BASE_NAME</name>
      <description>The base name of the report produced at the end of the DV update</description>
      <default_value>retail-dv-initial-report</default_value>
    </parameter>
  </parameters>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>50</xloc>
      <yloc>50</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>

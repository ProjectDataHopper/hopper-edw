      <historySchema>dv_ops</historySchema>
      <loadId>${DV_WORKFLOW_EXECUTION_ID}</loadId>
      <autoCreateTables>N</autoCreateTables>
      <publishCatalogDefinitions>N</publishCatalogDefinitions>
      <failOnPersistError>N</failOnPersistError>

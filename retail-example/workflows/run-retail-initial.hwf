<workflow>
  <name>run-retail-initial</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Initial retail load: drop, seed control, generate data, load CRM, DV + BV + DM</description>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/07/01 00:00:00.000</created_date>
  <modified_date>2026/07/01 00:00:00.000</modified_date>
  <workflow_version/>
  <parameters>
    <parameter>
      <name>DV_INITIAL_LOAD_DATE</name>
      <description>Fixed load date for initial Data Vault Update actions</description>
      <default_value>2024/01/01 00:00:00.000</default_value>
    </parameter>
    <parameter>
      <name>OUTPUT_COPIES</name>
      <description>Valid in the current workflow</description>
      <default_value>1</default_value>
    </parameter>
    <parameter>
      <name>PIPELINE_COPIES</name>
      <description>Valid in the current workflow</description>
      <default_value>3</default_value>
    </parameter>
    <parameter>
      <name>METRICS_FOLDER</name>
      <description>Valid in the current workflow</description>
      <default_value>${PROJECT_HOME}/work/metrics</default_value>
    </parameter>
  </parameters>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>96</xloc>
      <yloc>32</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <rootArtifactFilename/>
      <outputHemFile>${PROJECT_HOME}/work/execution-maps/run-retail-initial.hem</outputHemFile>
      <includeGeneratedPipelines>Y</includeGeneratedPipelines>
      <includeDatasetNodes>Y</includeDatasetNodes>
      <captureSnapshots>Y</captureSnapshots>
      <followNestedWorkflows>Y</followNestedWorkflows>
      <followNestedPipelines>Y</followNestedPipelines>
      <includeWorkflowActions>N</includeWorkflowActions>
      <includePipelineTransforms>N</includePipelineTransforms>
      <exportLineage>N</exportLineage>
      <name>Generate initial execution map</name>
      <type>GENERATE_EXECUTION_MAP</type>
      <attributes/>
      <xloc>640</xloc>
      <yloc>144</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <hostname>${DB_HOST}</hostname>
      <timeout>3000</timeout>
      <nbrPackets>2</nbrPackets>
      <pingtype>classicPing</pingtype>
      <name>ping db</name>
      <description/>
      <type>PING</type>
      <attributes/>
      <xloc>224</xloc>
      <yloc>32</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connections>
        <connection>
          <name>OPS</name>
          <waitfor>0</waitfor>
          <waittime>millisecond</waittime>
        </connection>
        <connection>
          <name>Vault</name>
          <waitfor>0</waitfor>
          <waittime>millisecond</waittime>
        </connection>
        <connection>
          <name>CRM</name>
          <waitfor>0</waitfor>
          <waittime>millisecond</waittime>
        </connection>
      </connections>
      <name>Check DB connections</name>
      <description/>
      <type>CHECK_DB_CONNECTIONS</type>
      <attributes/>
      <xloc>416</xloc>
      <yloc>32</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/workflows/run-retail-initial-setup-db.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <set_append_logfile>N</set_append_logfile>
      <create_parent_folder>N</create_parent_folder>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>run-retail-initial-setup-db</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <xloc>224</xloc>
      <yloc>144</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/workflows/run-retail-update-models.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Nothing</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <create_parent_folder>N</create_parent_folder>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>DV_ACTUAL_LOAD_DATE</name>
          <value>${DV_INITIAL_LOAD_DATE}</value>
          <stream_name/>
        </parameter>
        <parameter>
          <name>REPORT_BASE_NAME</name>
          <value>retail-dv-initial-report</value>
          <stream_name/>
        </parameter>
        <parameter>
          <name>EXPECT_AUTOMATIC_TARGET_TABLE_CREATION</name>
          <value>Y</value>
          <stream_name/>
        </parameter>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>run-retail-update-models</name>
      <description/>
      <type>WORKFLOW</type>
      <attributes/>
      <xloc>416</xloc>
      <yloc>144</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <rootArtifactFilename>${Internal.Workflow.Filename.Folder}/${Internal.Workflow.Filename.Name}</rootArtifactFilename>
      <viewType>SOLUTION</viewType>
      <outputDrawioFile>${PROJECT_HOME}/work/drawio/retail-solution.drawio</outputDrawioFile>
      <alsoExportDataView>Y</alsoExportDataView>
      <dataOutputDrawioFile>${PROJECT_HOME}/work/drawio/retail-data.drawio</dataOutputDrawioFile>
      <alsoExportModelDiagrams>Y</alsoExportModelDiagrams>
      <modelsOutputFolder>${PROJECT_HOME}/work/drawio/</modelsOutputFolder>
      <name>Export architecture</name>
      <description/>
      <type>EXPORT_ARCHITECTURE</type>
      <attributes/>
      <xloc>640</xloc>
      <yloc>224</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>ping db</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>ping db</from>
      <to>Check DB connections</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check DB connections</from>
      <to>run-retail-initial-setup-db</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>run-retail-initial-setup-db</from>
      <to>run-retail-update-models</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>run-retail-update-models</from>
      <to>Generate initial execution map</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>run-retail-update-models</from>
      <to>Export architecture</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>

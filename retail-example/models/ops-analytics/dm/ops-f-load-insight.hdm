<dimensional-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Insert-only fact f_load_insight. Dimension roles alias ops-analytics-dimensions.</description>
  <configurationName>ops-analytics-dm</configurationName>
  <semanticModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-f-load-insight.hsl</semanticModelFilename>
  <tables>
    <table>
      <dimension_roles>
        <dimension_role>
          <dimensionTableName>dim_load_date</dimensionTableName>
          <foreignKeyColumn>started_at_key</foreignKeyColumn>
          <sourceFieldName>started_at</sourceFieldName>
          <truncateToDateKey>Y</truncateToDateKey>
          <preloadLookupCache>N</preloadLookupCache>
          <skipDimensionLookup>N</skipDimensionLookup>
          <forceDimensionLookup>N</forceDimensionLookup>
        </dimension_role>
      </dimension_roles>
      <measures>
        <measure>
          <fieldName>row_count</fieldName>
          <additive>Y</additive>
        </measure>
      </measures>
      <degenerate_dimensions>
        <degenerate_dimension>
          <fieldName>severity</fieldName>
        </degenerate_dimension>
        <degenerate_dimension>
          <fieldName>code</fieldName>
        </degenerate_dimension>
        <degenerate_dimension>
          <fieldName>element_name</fieldName>
        </degenerate_dimension>
      </degenerate_dimensions>
      <range_dimension_roles/>
      <junk_dimension_roles/>
      <tableName>f_load_insight</tableName>
      <description>Insert-only fact from sat_lnk_load_insight</description>
      <grain>One row per load insight</grain>
      <business_process>
        <business>Operational analytics</business>
        <level1>Load</level1>
      </business_process>
      <tableType>FACT</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>SELECT s.*, 1 AS row_count, r.started_at
FROM sat_lnk_load_insight s
JOIN lnk_load_insight l ON s.lnk_load_insight_hk = l.lnk_load_insight_hk
JOIN sat_load_run r ON l.load_run_hk = r.load_run_hk</sourceSql>
      <xloc>320</xloc>
      <yloc>160</yloc>
      <name>fact_load_insight</name>
    </table>
    <table>
      <referencedDimensionName>dim_date</referencedDimensionName>
      <referencedModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-analytics-dimensions.hdm</referencedModelFilename>
      <tableName>d_date</tableName>
      <description>Role-playing alias of dim_date</description>
      <tableType>DIMENSION_ALIAS</tableType>
      <sourceType>SQL</sourceType>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <name>dim_load_date</name>
    </table>
  </tables>
  <conformed_dimensions/>
  <notes/>
  <name>ops-f-load-insight</name>
</dimensional-model>

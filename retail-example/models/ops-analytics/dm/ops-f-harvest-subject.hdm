<dimensional-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Insert-only fact f_harvest_subject. Dimension roles alias ops-analytics-dimensions.</description>
  <configurationName>ops-analytics-dm</configurationName>
  <semanticModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-f-harvest-subject.hsl</semanticModelFilename>
  <tables>
    <table>
      <dimension_roles>
        <dimension_role>
          <dimensionTableName>dim_subject</dimensionTableName>
          <foreignKeyColumn>subject_key</foreignKeyColumn>
          <sourceFieldName>subject_key</sourceFieldName>
          <truncateToDateKey>N</truncateToDateKey>
          <preloadLookupCache>N</preloadLookupCache>
          <skipDimensionLookup>N</skipDimensionLookup>
          <forceDimensionLookup>N</forceDimensionLookup>
        </dimension_role>
      </dimension_roles>
      <measures>
        <measure>
          <fieldName>change_count</fieldName>
          <additive>Y</additive>
        </measure>
      </measures>
      <degenerate_dimensions>
        <degenerate_dimension>
          <fieldName>harvest_run_id</fieldName>
        </degenerate_dimension>
      </degenerate_dimensions>
      <range_dimension_roles/>
      <junk_dimension_roles/>
      <tableName>f_harvest_subject</tableName>
      <description>Transaction fact published from link satellite 'sat_lnk_schema_harvest_subject' (parent link 'lnk_schema_harvest_subject').</description>
      <grain>One row per harvest subject</grain>
      <business_process>
        <business>Operational analytics</business>
        <level1>Harvest</level1>
      </business_process>
      <tableType>FACT</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>SELECT s.*, h0.subject_key, h1.harvest_run_id
FROM sat_lnk_schema_harvest_subject s
JOIN lnk_schema_harvest_subject l ON s.lnk_schema_harvest_subject_hk = l.lnk_schema_harvest_subject_hk
JOIN hub_subject h0 ON l.subject_hk = h0.subject_hk
JOIN hub_schema_harvest_run h1 ON l.schema_harvest_run_hk = h1.schema_harvest_run_hk</sourceSql>
      <xloc>320</xloc>
      <yloc>160</yloc>
      <name>fact_harvest_subject</name>
    </table>
    <table>
      <referencedDimensionName>dim_subject</referencedDimensionName>
      <referencedModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-analytics-dimensions.hdm</referencedModelFilename>
      <tableName>d_subject</tableName>
      <description>Conformed dimension dim_subject</description>
      <tableType>DIMENSION_ALIAS</tableType>
      <sourceType>SQL</sourceType>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <name>dim_subject</name>
    </table>
  </tables>
  <conformed_dimensions/>
  <notes/>
  <name>ops-f-harvest-subject</name>
</dimensional-model>

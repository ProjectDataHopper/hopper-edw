<semantic-model>
  <description>Consumption layer for operational analytics.</description>
  <dimensionalModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-f-quality-finding.hdm</dimensionalModelFilename>
  <targetDatabase>ops-analytics-dm</targetDatabase>
  <entities>
    <entity>
      <name>fact_quality_finding</name>
      <description>Insert-only fact from sat_lnk_quality_finding</description>
      <role>FACT</role>
      <binding>
        <kind>HDM</kind>
        <modelFilename>/home/matt/git/ProjectDataHopper/hopper-edw/retail-example/models/ops-analytics/dm/ops-f-quality-finding.hdm</modelFilename>
        <tableName>fact_quality_finding</tableName>
        <physicalTableName>f_quality_finding</physicalTableName>
      </binding>
      <attributes>
        <attribute>
          <name>rule_name</name>
          <physicalColumn>rule_name</physicalColumn>
          <header>Rule name</header>
          <formatMask/>
        </attribute>
        <attribute>
          <name>rule_type</name>
          <physicalColumn>rule_type</physicalColumn>
          <header>Rule type</header>
          <formatMask/>
        </attribute>
        <attribute>
          <name>severity</name>
          <physicalColumn>severity</physicalColumn>
          <header>Severity</header>
          <formatMask/>
        </attribute>
        <attribute>
          <name>field_name</name>
          <physicalColumn>field_name</physicalColumn>
          <header>Field name</header>
          <formatMask/>
        </attribute>
      </attributes>
      <measures>
        <measure>
          <name>row_count</name>
          <physicalColumn>row_count</physicalColumn>
          <header>Row count</header>
          <formatMask>#,##0.00</formatMask>
          <aggregation>SUM</aggregation>
          <additive>Y</additive>
        </measure>
        <measure>
          <name>finding_count</name>
          <physicalColumn>severity</physicalColumn>
          <header>Finding count</header>
          <aggregation>COUNT</aggregation>
          <additive>N</additive>
        </measure>
      </measures>
    </entity>
    <entity>
      <name>dim_subject</name>
      <description>Conformed dimension dim_subject</description>
      <role>DIMENSION</role>
      <binding>
        <kind>HDM</kind>
        <modelFilename>/home/matt/git/ProjectDataHopper/hopper-edw/retail-example/models/ops-analytics/dm/ops-f-quality-finding.hdm</modelFilename>
        <tableName>dim_subject</tableName>
        <physicalTableName>d_subject</physicalTableName>
      </binding>
      <attributes>
        <attribute>
          <name>subject_key</name>
          <physicalColumn>subject_key</physicalColumn>
          <header>Subject key</header>
          <formatMask/>
        </attribute>
      </attributes>
      <measures/>
    </entity>
    <entity>
      <name>dim_rule</name>
      <description>Conformed dimension dim_rule</description>
      <role>DIMENSION</role>
      <binding>
        <kind>HDM</kind>
        <modelFilename>/home/matt/git/ProjectDataHopper/hopper-edw/retail-example/models/ops-analytics/dm/ops-f-quality-finding.hdm</modelFilename>
        <tableName>dim_rule</tableName>
        <physicalTableName>d_rule</physicalTableName>
      </binding>
      <attributes>
        <attribute>
          <name>rule_id</name>
          <physicalColumn>rule_id</physicalColumn>
          <header>Rule id</header>
          <formatMask/>
        </attribute>
      </attributes>
      <measures/>
    </entity>
  </entities>
  <relationships>
    <relationship>
      <name>fact_quality_finding_dim_subject</name>
      <fromEntity>fact_quality_finding</fromEntity>
      <toEntity>dim_subject</toEntity>
      <joinType>INNER</joinType>
      <fromField>subject_key</fromField>
      <toField>subject_key</toField>
      <roleName>dim_subject</roleName>
    </relationship>
    <relationship>
      <name>fact_quality_finding_dim_rule</name>
      <fromEntity>fact_quality_finding</fromEntity>
      <toEntity>dim_rule</toEntity>
      <joinType>INNER</joinType>
      <fromField>rule_key</fromField>
      <toField>rule_id</toField>
      <roleName>dim_rule</roleName>
    </relationship>
  </relationships>
  <selections>
    <selection>
      <name>quality-findings-by-severity</name>
      <entityName>fact_quality_finding</entityName>
      <groups/>
      <rows>
        <row>
          <entityName>dim_subject</entityName>
          <fieldName>subject_key</fieldName>
        </row>
      </rows>
      <columns>
        <column>
          <entityName>fact_quality_finding</entityName>
          <fieldName>severity</fieldName>
        </column>
      </columns>
      <measures>
        <measure>
          <entityName>fact_quality_finding</entityName>
          <fieldName>finding_count</fieldName>
        </measure>
      </measures>
      <showingHorizontalTotals>Y</showingHorizontalTotals>
      <showingVerticalTotals>Y</showingVerticalTotals>
    </selection>
  </selections>
  <name>ops-f-quality-finding</name>
</semantic-model>

<dimensional-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Insert-only fact f_quality_finding. Dimension roles alias ops-analytics-dimensions.</description>
  <configurationName>ops-analytics-dm</configurationName>
  <semanticModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-f-quality-finding.hsl</semanticModelFilename>
  <tables>
    <table>
      <dimension_roles>
        <dimension_role>
          <dimensionTableName>dim_subject</dimensionTableName>
          <foreignKeyColumn>subject_key</foreignKeyColumn>
          <sourceFieldName>subject_key</sourceFieldName>
          <truncateToDateKey>N</truncateToDateKey>
          <preloadLookupCache>N</preloadLookupCache>
          <skipDimensionLookup>N</skipDimensionLookup>
          <forceDimensionLookup>N</forceDimensionLookup>
        </dimension_role>
        <dimension_role>
          <dimensionTableName>dim_rule</dimensionTableName>
          <foreignKeyColumn>rule_key</foreignKeyColumn>
          <sourceFieldName>rule_id</sourceFieldName>
          <truncateToDateKey>N</truncateToDateKey>
          <preloadLookupCache>N</preloadLookupCache>
          <skipDimensionLookup>N</skipDimensionLookup>
          <forceDimensionLookup>N</forceDimensionLookup>
        </dimension_role>
      </dimension_roles>
      <measures>
        <measure>
          <fieldName>row_count</fieldName>
          <additive>Y</additive>
        </measure>
      </measures>
      <degenerate_dimensions>
        <degenerate_dimension>
          <fieldName>rule_name</fieldName>
        </degenerate_dimension>
        <degenerate_dimension>
          <fieldName>rule_type</fieldName>
        </degenerate_dimension>
        <degenerate_dimension>
          <fieldName>severity</fieldName>
        </degenerate_dimension>
        <degenerate_dimension>
          <fieldName>field_name</fieldName>
        </degenerate_dimension>
      </degenerate_dimensions>
      <range_dimension_roles/>
      <junk_dimension_roles/>
      <tableName>f_quality_finding</tableName>
      <description>Insert-only fact from sat_lnk_quality_finding</description>
      <grain>One row per quality finding</grain>
      <business_process>
        <business>Operational analytics</business>
        <level1>Quality</level1>
      </business_process>
      <tableType>FACT</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>SELECT s.*, 1 AS row_count, h0.subject_key, h1.rule_id
FROM sat_lnk_quality_finding s
JOIN lnk_quality_finding l ON s.lnk_quality_finding_hk = l.lnk_quality_finding_hk
JOIN hub_subject h0 ON l.subject_hk = h0.subject_hk
JOIN hub_rule h1 ON l.rule_hk = h1.rule_hk</sourceSql>
      <xloc>320</xloc>
      <yloc>160</yloc>
      <name>fact_quality_finding</name>
    </table>
    <table>
      <referencedDimensionName>dim_subject</referencedDimensionName>
      <referencedModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-analytics-dimensions.hdm</referencedModelFilename>
      <tableName>d_subject</tableName>
      <description>Conformed dimension dim_subject</description>
      <tableType>DIMENSION_ALIAS</tableType>
      <sourceType>SQL</sourceType>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <name>dim_subject</name>
    </table>
    <table>

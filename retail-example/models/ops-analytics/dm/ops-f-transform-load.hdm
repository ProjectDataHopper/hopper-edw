<dimensional-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Insert-only fact f_transform_load. Dimension roles alias ops-analytics-dimensions.</description>
  <configurationName>ops-analytics-dm</configurationName>
  <semanticModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-f-transform-load.hsl</semanticModelFilename>
  <tables>
    <table>
      <dimension_roles>
        <dimension_role>
          <dimensionTableName>dim_transform</dimensionTableName>
          <foreignKeyColumn>transform_key</foreignKeyColumn>
          <sourceFieldName>transform_key</sourceFieldName>
          <truncateToDateKey>N</truncateToDateKey>
          <preloadLookupCache>N</preloadLookupCache>
          <skipDimensionLookup>N</skipDimensionLookup>
          <forceDimensionLookup>N</forceDimensionLookup>
        </dimension_role>
      </dimension_roles>
      <measures>
        <measure>
          <fieldName>rows_read</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>rows_written</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>rows_updated</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>rows_rejected</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>errors</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>duration_ms</fieldName>
          <additive>Y</additive>
        </measure>
      </measures>
      <degenerate_dimensions>
        <degenerate_dimension>
          <fieldName>run_id</fieldName>
        </degenerate_dimension>
        <degenerate_dimension>
          <fieldName>element_type</fieldName>
        </degenerate_dimension>
        <degenerate_dimension>
          <fieldName>element_name</fieldName>
        </degenerate_dimension>
      </degenerate_dimensions>
      <range_dimension_roles/>
      <junk_dimension_roles/>
      <tableName>f_transform_load</tableName>
      <description>Transaction fact published from link satellite 'sat_lnk_load_transform_metric' (parent link 'lnk_load_transform_metric').</description>
      <grain>One row per transform load</grain>
      <business_process>
        <business>Operational analytics</business>
        <level1>Load</level1>
      </business_process>
      <tableType>FACT</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>SELECT s.*, CONCAT(h0.pipeline_name, '|', h0.transform_name) AS transform_key, h1.run_id
FROM sat_lnk_load_transform_metric s
JOIN lnk_load_transform_metric l ON s.lnk_load_transform_metric_hk = l.lnk_load_transform_metric_hk
JOIN hub_transform h0 ON l.transform_hk = h0.transform_hk
JOIN hub_load_run h1 ON l.load_run_hk = h1.load_run_hk</sourceSql>
      <xloc>320</xloc>
      <yloc>160</yloc>
      <name>fact_transform_load</name>
    </table>
    <table>
      <referencedDimensionName>dim_transform</referencedDimensionName>
      <referencedModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-analytics-dimensions.hdm</referencedModelFilename>
      <tableName>d_transform</tableName>
      <description>Conformed dimension dim_transform</description>
      <tableType>DIMENSION_ALIAS</tableType>
      <sourceType>SQL</sourceType>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <name>dim_transform</name>
    </table>
  </tables>
  <conformed_dimensions/>
  <notes/>
  <name>ops-f-transform-load</name>
</dimensional-model>

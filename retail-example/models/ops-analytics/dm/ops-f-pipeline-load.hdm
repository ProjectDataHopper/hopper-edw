      <tableName>f_pipeline_load</tableName>
      <description>Transaction fact published from link satellite 'sat_lnk_load_pipeline_metric' (parent link 'lnk_load_pipeline_metric').</description>
      <grain>One row per pipeline load</grain>
      <business_process>
        <business>Operational analytics</business>
        <level1>Load</level1>
      </business_process>
      <tableType>FACT</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>SELECT s.*, h0.pipeline_name, h1.run_id
FROM sat_lnk_load_pipeline_metric s
JOIN lnk_load_pipeline_metric l ON s.lnk_load_pipeline_metric_hk = l.lnk_load_pipeline_metric_hk
JOIN hub_pipeline h0 ON l.pipeline_hk = h0.pipeline_hk
JOIN hub_load_run h1 ON l.load_run_hk = h1.load_run_hk</sourceSql>
      <xloc>320</xloc>
      <yloc>160</yloc>
      <name>fact_pipeline_load</name>

<dimensional-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Conformed dimensions for operational analytics, including dim_date.</description>
  <configurationName>ops-analytics-dm</configurationName>
  <tables>
    <table>
      <scdType>TYPE1</scdType>
      <natural_keys>
        <natural_key>
          <fieldName>date_key</fieldName>
        </natural_key>
      </natural_keys>
      <attributes>
        <attribute>
          <fieldName>full_date</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>day_of_week</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>day_of_month</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>day_of_year</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>week_of_year</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>month</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>month_name</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>quarter</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>year</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>is_weekend</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
      </attributes>
      <outriggers/>
      <surrogateKeyStrategy>NONE</surrogateKeyStrategy>
      <tableName>d_date</tableName>
      <description>Calendar date dimension</description>
      <tableType>DIMENSION</tableType>
      <sourceType>DATE_GENERATOR</sourceType>
      <sourceSql/>
      <dateGenerator>
        <startDate>2000-01-01</startDate>
        <endDate>2030-12-31</endDate>
        <referenceDate/>
        <dayOffset>0</dayOffset>
        <weekOffset>0</weekOffset>
        <monthOffset>0</monthOffset>
        <fields>
          <field>
            <name>date_key</name>
            <hopType>5</hopType>
            <length>8</length>
            <precision>0</precision>
            <formatMask>yyyyMMdd</formatMask>
            <locale/>
          </field>
          <field>
            <name>full_date</name>
            <hopType>3</hopType>
            <length/>
            <precision/>
            <formatMask>yyyy-MM-dd</formatMask>
            <locale/>
          </field>
          <field>
            <name>day_of_week</name>
            <hopType>5</hopType>
            <length>1</length>
            <precision>0</precision>
            <formatMask>@day_of_week</formatMask>
            <locale/>
          </field>
          <field>
            <name>day_of_month</name>
            <hopType>5</hopType>
            <length>2</length>
            <precision>0</precision>
            <formatMask>d</formatMask>
            <locale/>
          </field>
          <field>
            <name>day_of_year</name>
            <hopType>5</hopType>
            <length>3</length>
            <precision>0</precision>
            <formatMask>D</formatMask>
            <locale/>
          </field>
          <field>
            <name>week_of_year</name>
            <hopType>5</hopType>
            <length>2</length>
            <precision>0</precision>
            <formatMask>w</formatMask>
            <locale/>
          </field>
          <field>
            <name>month</name>
            <hopType>5</hopType>
            <length>2</length>
            <precision>0</precision>
            <formatMask>M</formatMask>
            <locale/>
          </field>
          <field>
            <name>month_name</name>
            <hopType>2</hopType>
            <length>20</length>
            <precision>0</precision>
            <formatMask>MMMM</formatMask>
            <locale>en_US</locale>
          </field>
          <field>
            <name>quarter</name>
            <hopType>5</hopType>
            <length>1</length>
            <precision>0</precision>
            <formatMask>Q</formatMask>
            <locale/>
          </field>
          <field>
            <name>year</name>
            <hopType>5</hopType>
            <length>4</length>
            <precision>0</precision>
            <formatMask>yyyy</formatMask>
            <locale/>
          </field>
          <field>
            <name>is_weekend</name>
            <hopType>4</hopType>
            <length/>
            <precision/>
            <formatMask>@is_weekend</formatMask>
            <locale/>
          </field>
          <field>
            <name>load_dt</name>
            <hopType>9</hopType>
            <length/>
            <precision/>
            <formatMask>@now</formatMask>
            <locale/>
          </field>
        </fields>
      </dateGenerator>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <name>dim_date</name>
    </table>
    <table>
      <scdType>TYPE1</scdType>
      <natural_keys>
        <natural_key>
          <fieldName>model_key</fieldName>
        </natural_key>
      </natural_keys>
      <attributes>
        <attribute>
          <fieldName>model_type</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>model_name</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
      </attributes>
      <outriggers/>
      <tableName>d_model</tableName>
      <description>Dimension published from hub 'hub_model'.</description>
      <tableType>DIMENSION</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>SELECT CONCAT(model_type, '|', model_name) AS model_key, model_type, model_name, load_date AS load_dt
FROM hub_model</sourceSql>
      <xloc>304</xloc>
      <yloc>64</yloc>
      <name>dim_model</name>
    </table>
    <table>
      <scdType>TYPE1</scdType>
      <natural_keys>
        <natural_key>
          <fieldName>pipeline_name</fieldName>
        </natural_key>
      </natural_keys>
      <attributes/>
      <outriggers/>
      <tableName>d_pipeline</tableName>
      <description>Dimension published from hub 'hub_pipeline'.</description>
      <tableType>DIMENSION</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>-- DRAFT: review source SQL published from 'hub_pipeline'
SELECT *, load_date AS load_dt FROM hub_pipeline</sourceSql>
      <xloc>544</xloc>
      <yloc>64</yloc>
      <name>dim_pipeline</name>
    </table>
    <table>
      <scdType>TYPE1</scdType>
      <natural_keys>
        <natural_key>
          <fieldName>rule_id</fieldName>
        </natural_key>
      </natural_keys>
      <attributes/>
      <outriggers/>
      <tableName>d_rule</tableName>
      <description>Dimension published from hub 'hub_rule'.</description>
      <tableType>DIMENSION</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>-- DRAFT: review source SQL published from 'hub_rule'
SELECT *, load_date AS load_dt FROM hub_rule</sourceSql>
      <xloc>64</xloc>
      <yloc>204</yloc>
      <name>dim_rule</name>
    </table>
    <table>
      <scdType>TYPE1</scdType>
      <natural_keys>
        <natural_key>
          <fieldName>subject_key</fieldName>
        </natural_key>
      </natural_keys>
      <attributes/>
      <outriggers/>
      <tableName>d_subject</tableName>
      <description>Dimension published from hub 'hub_subject'.</description>
      <tableType>DIMENSION</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>-- DRAFT: review source SQL published from 'hub_subject'
SELECT *, load_date AS load_dt FROM hub_subject</sourceSql>
      <xloc>304</xloc>
      <yloc>204</yloc>
      <name>dim_subject</name>
    </table>
    <table>
      <scdType>TYPE1</scdType>
      <natural_keys>
        <natural_key>
          <fieldName>transform_key</fieldName>
        </natural_key>
      </natural_keys>
      <attributes>
        <attribute>
          <fieldName>pipeline_name</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
        <attribute>
          <fieldName>transform_name</fieldName>
          <scdUpdatePolicy>TYPE1</scdUpdatePolicy>
        </attribute>
      </attributes>
      <outriggers/>
      <tableName>d_transform</tableName>
      <description>Dimension published from hub 'hub_transform'.</description>
      <tableType>DIMENSION</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>SELECT CONCAT(pipeline_name, '|', transform_name) AS transform_key, pipeline_name, transform_name, load_date AS load_dt
FROM hub_transform</sourceSql>
      <xloc>544</xloc>
      <yloc>204</yloc>
      <name>dim_transform</name>
    </table>
  </tables>
  <conformed_dimensions/>
  <notes/>
  <name>ops-analytics-dimensions</name>
</dimensional-model>

<dimensional-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Insert-only fact f_workflow_model. Dimension roles alias ops-analytics-dimensions.</description>
  <configurationName>ops-analytics-dm</configurationName>
  <semanticModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-f-workflow-model.hsl</semanticModelFilename>
  <tables>
    <table>
      <dimension_roles>
        <dimension_role>
          <dimensionTableName>dim_model</dimensionTableName>
          <foreignKeyColumn>model_key</foreignKeyColumn>
          <sourceFieldName>model_key</sourceFieldName>
          <truncateToDateKey>N</truncateToDateKey>
          <preloadLookupCache>N</preloadLookupCache>
          <skipDimensionLookup>N</skipDimensionLookup>
          <forceDimensionLookup>N</forceDimensionLookup>
        </dimension_role>
      </dimension_roles>
      <measures>
        <measure>
          <fieldName>pipeline_count</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>source_rows_read</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>target_rows_read</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>target_rows_inserted</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>errors</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>duration_ms</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>insight_count</fieldName>
          <additive>Y</additive>
        </measure>
      </measures>
      <degenerate_dimensions>
        <degenerate_dimension>
          <fieldName>overview_id</fieldName>
        </degenerate_dimension>
        <degenerate_dimension>
          <fieldName>load_run_id</fieldName>
        </degenerate_dimension>
        <degenerate_dimension>
          <fieldName>success</fieldName>
        </degenerate_dimension>
      </degenerate_dimensions>
      <range_dimension_roles/>
      <junk_dimension_roles/>
      <tableName>f_workflow_model</tableName>
      <description>Transaction fact published from link satellite 'sat_lnk_workflow_load_overview_model' (parent link 'lnk_workflow_load_overview_model').</description>
      <grain>One row per workflow model</grain>
      <business_process>
        <business>Operational analytics</business>
        <level1>Load</level1>
      </business_process>
      <tableType>FACT</tableType>
      <sourceType>SQL</sourceType>
      <sourceSql>SELECT s.*, CONCAT(h0.model_type, '|', h0.model_name) AS model_key, h1.overview_id, h2.run_id AS load_run_id
FROM sat_lnk_workflow_load_overview_model s
JOIN lnk_workflow_load_overview_model l ON s.lnk_workflow_load_overview_model_hk = l.lnk_workflow_load_overview_model_hk
JOIN hub_model h0 ON l.model_hk = h0.model_hk
JOIN hub_workflow_load_overview h1 ON l.workflow_load_overview_hk = h1.workflow_load_overview_hk
JOIN hub_load_run h2 ON l.load_run_hk = h2.load_run_hk</sourceSql>
      <xloc>320</xloc>
      <yloc>160</yloc>
      <name>fact_workflow_model</name>
    </table>
    <table>
      <referencedDimensionName>dim_model</referencedDimensionName>
      <referencedModelFilename>${PROJECT_HOME}/models/ops-analytics/dm/ops-analytics-dimensions.hdm</referencedModelFilename>
      <tableName>d_model</tableName>
      <description>Conformed dimension dim_model</description>
      <tableType>DIMENSION_ALIAS</tableType>
      <sourceType>SQL</sourceType>
      <xloc>64</xloc>
      <yloc>64</yloc>
      <name>dim_model</name>
    </table>
  </tables>
  <conformed_dimensions/>
  <notes/>
  <name>ops-f-workflow-model</name>
</dimensional-model>

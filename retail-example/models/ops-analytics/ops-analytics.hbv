      <referencedModelFilename>/home/matt/git/ProjectDataHopper/hopper-edw/retail-example/models/ops-analytics/dv/ops_hub_load_run.hdv</referencedModelFilename>
      <xloc>700</xloc>
      <yloc>40</yloc>
    </dv_reference>
    <dv_reference>
      <dvTableName>sat_load_run</dvTableName>
      <dvTableType>SATELLITE</dvTableType>
      <referencedModelFilename>/home/matt/git/ProjectDataHopper/hopper-edw/retail-example/models/ops-analytics/dv/ops_hub_load_run.hdv</referencedModelFilename>
      <xloc>700</xloc>
      <yloc>130</yloc>
    </dv_reference>
    <dv_reference>
      <dvTableName>hub_model</dvTableName>
      <dvTableType>HUB</dvTableType>
      <referencedModelFilename>/home/matt/git/ProjectDataHopper/hopper-edw/retail-example/models/ops-analytics/dv/ops_hub_model.hdv</referencedModelFilename>
      <xloc>700</xloc>
      <yloc>220</yloc>

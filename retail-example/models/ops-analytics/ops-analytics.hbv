<business-vault-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Operational analytics Business Vault. Duration and latest load are SQL views. The bridge relates a workflow execution to the models it loaded.</description>
  <configurationName>ops-analytics-bv</configurationName>
  <tables>
    <table>
      <sqlQuery>SELECT h.load_run_hk, h.run_id, s.started_at, s.finished_at, s.success, CASE WHEN s.started_at IS NULL OR s.finished_at IS NULL THEN NULL ELSE EXTRACT(EPOCH FROM (s.finished_at - s.started_at)) * 1000 END AS duration_ms
FROM {{ ref('sat_load_run') }} s
JOIN {{ ref('hub_load_run') }} h ON s.load_run_hk = h.load_run_hk
</sqlQuery>
      <referenceStyle>DBT</referenceStyle>
      <materialization>VIEW</materialization>
      <schemaName>ops_bv</schemaName>
      <column_notes/>
      <sql_sources/>
      <sql_refs/>
      <tableName>bv_load_run_duration</tableName>
      <description>Load duration in milliseconds from sat_load_run timestamps.</description>
      <tableType>BUSINESS_TABLE</tableType>
      <derivatives/>
      <source_query_refs/>
      <xloc>40</xloc>
      <yloc>40</yloc>
      <name>bv_load_run_duration</name>
    </table>
    <table>
      <sqlQuery>SELECT model_type, model_name, run_id, started_at, finished_at, success, duration_ms
FROM (
  SELECT m.model_type AS model_type, m.model_name AS model_name, h.run_id AS run_id,
    s.started_at, s.finished_at, s.success, CASE WHEN s.started_at IS NULL OR s.finished_at IS NULL THEN NULL ELSE EXTRACT(EPOCH FROM (s.finished_at - s.started_at)) * 1000 END AS duration_ms,
    ROW_NUMBER() OVER (PARTITION BY m.model_type, m.model_name ORDER BY s.started_at DESC) AS load_rank
  FROM {{ ref('lnk_load_run_model') }} l
  JOIN {{ ref('hub_model') }} m ON l.model_hk = m.model_hk
  JOIN {{ ref('hub_load_run') }} h ON l.load_run_hk = h.load_run_hk
  JOIN {{ ref('sat_load_run') }} s ON l.load_run_hk = s.load_run_hk
) ranked
WHERE load_rank = 1
</sqlQuery>
      <referenceStyle>DBT</referenceStyle>
      <materialization>VIEW</materialization>
      <schemaName>ops_bv</schemaName>
      <column_notes/>
      <sql_sources/>
      <sql_refs/>
      <tableName>bv_model_latest_load</tableName>
      <description>Latest load_run per model, by started_at. Not an SCD2 version.</description>
      <tableType>BUSINESS_TABLE</tableType>
      <derivatives/>
      <source_query_refs/>
      <xloc>40</xloc>
      <yloc>220</yloc>
      <name>bv_model_latest_load</name>
    </table>
    <table>
      <sqlQuery>SELECT DISTINCT w.workflow_execution_hk, m.model_hk
FROM {{ ref('lnk_load_run_workflow_execution') }} w
JOIN {{ ref('lnk_load_run_model') }} m ON w.load_run_hk = m.load_run_hk
</sqlQuery>
      <schemaName>ops_bv</schemaName>
      <tableName>bv_workflow_models</tableName>
      <description>Workflow execution hub hash to model hub hash, through the load-run links.</description>
      <tableType>BRIDGE</tableType>
      <derivatives>
        <derivative>
          <dvTableName>hub_workflow_execution</dvTableName>
          <dvTableType>HUB</dvTableType>
        </derivative>
        <derivative>
          <dvTableName>hub_model</dvTableName>
          <dvTableType>HUB</dvTableType>
        </derivative>
      </derivatives>
      <source_query_refs/>
      <xloc>40</xloc>
      <yloc>420</yloc>
      <name>bv_workflow_models</name>
    </table>
  </tables>
  <notes/>
  <dv_references>
    <dv_reference>
      <dvTableName>hub_load_run</dvTableName>

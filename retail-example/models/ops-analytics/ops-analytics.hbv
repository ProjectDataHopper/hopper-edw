    <dv_reference>
      <dvTableName>hub_workflow_execution</dvTableName>
      <dvTableType>HUB</dvTableType>
      <referencedModelFilename>/home/matt/git/ProjectDataHopper/hopper-edw/retail-example/models/ops-analytics/dv/ops_hub_workflow_execution.hdv</referencedModelFilename>
      <xloc>700</xloc>

      <referencedModelFilename>/home/matt/git/ProjectDataHopper/hopper-edw/retail-example/models/ops-analytics/dv/ops_lnk_load_run_model.hdv</referencedModelFilename>
      <xloc>700</xloc>
      <yloc>400</yloc>
    </dv_reference>
    <dv_reference>
      <dvTableName>lnk_load_run_workflow_execution</dvTableName>
      <dvTableType>LINK</dvTableType>
      <referencedModelFilename>/home/matt/git/ProjectDataHopper/hopper-edw/retail-example/models/ops-analytics/dv/ops_lnk_load_run_workflow_execution.hdv</referencedModelFilename>

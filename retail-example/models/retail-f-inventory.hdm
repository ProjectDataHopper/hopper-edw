<dimensional-model>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description/>
  <configurationName>dimensional-inventory</configurationName>
  <coaching>
    <coaching_sources/>
  </coaching>
  <tables>
    <table>
      <dimension_roles>
        <dimension_role>
          <dimensionTableName>d_status_date</dimensionTableName>
          <foreignKeyColumn>status_date_key</foreignKeyColumn>
          <sourceFieldName>status_ts</sourceFieldName>
          <truncateToDateKey>Y</truncateToDateKey>
          <preloadLookupCache>N</preloadLookupCache>
          <skipDimensionLookup>N</skipDimensionLookup>
          <forceDimensionLookup>Y</forceDimensionLookup>
        </dimension_role>
        <dimension_role>
          <dimensionTableName>d_warehouse</dimensionTableName>
          <foreignKeyColumn>warehouse_id</foreignKeyColumn>
          <sourceFieldName>warehouse_id</sourceFieldName>
          <truncateToDateKey>N</truncateToDateKey>
          <preloadLookupCache>N</preloadLookupCache>
          <skipDimensionLookup>Y</skipDimensionLookup>
          <forceDimensionLookup>N</forceDimensionLookup>
        </dimension_role>
        <dimension_role>
          <dimensionTableName>d_product</dimensionTableName>
          <foreignKeyColumn>product_hk</foreignKeyColumn>
          <sourceFieldName>product_hk</sourceFieldName>
          <truncateToDateKey>N</truncateToDateKey>
          <preloadLookupCache>Y</preloadLookupCache>
          <skipDimensionLookup>Y</skipDimensionLookup>
          <forceDimensionLookup>N</forceDimensionLookup>
        </dimension_role>
      </dimension_roles>
      <measures>
        <measure>
          <fieldName>stock_qty</fieldName>
          <additive>Y</additive>
        </measure>
        <measure>
          <fieldName>reorder_point</fieldName>
          <additive>N</additive>
        </measure>
      </measures>
      <degenerate_dimensions/>
      <range_dimension_roles>
        <range_dimension_role>
          <rangeDimensionTableName>qty_class</rangeDimensionTableName>
          <sourceFieldName>stock_qty</sourceFieldName>
          <targetFieldName>qty_class</targetFieldName>
        </range_dimension_role>
      </range_dimension_roles>
      <junk_dimension_roles/>
      <tableName>f_pit_inventory</tableName>
      <description/>
      <tableType>FACT</tableType>
      <sourceType>SQL</sourceType>
      <sourceConnection>Vault</sourceConnection>
      <sourceSql>SELECT lwp.x_load_ts AS status_ts, lwp.product_hk, hp.product_id, lwp.warehouse_hk, hw.warehouse_id, 
       lwp.x_record_source, lwp.x_load_ts, slwp.stock_qty, slwp.reorder_point  
FROM lnk_warehouse_product lwp 
JOIN sat_lnk_warehouse_product slwp ON lwp.lnk_warehouse_product_hk = slwp.lnk_warehouse_product_hk 
JOIN hub_warehouse hw ON lwp.warehouse_hk = hw.warehouse_hk 
JOIN hub_product hp ON lwp.product_hk = hp.product_hk </sourceSql>
      <sourcePipelineFile/>
      <sourcePipelineTransform/>
      <sourcePipelineRunConfiguration/>
      <sourceCatalogConnection>local-catalog</sourceCatalogConnection>
      <sourceRecordNamespace/>
      <sourceRecordName/>
      <dimensionLookupDateField>status_ts</dimensionLookupDateField>
      <xloc>320</xloc>
      <yloc>192</yloc>
      <name>f_pit_inventory</name>
    </table>
    <table>
      <referencedDimensionName>d_warehouse</referencedDimensionName>
      <referencedModelFilename>${PROJECT_HOME}/models/retail-conformed-dims.hdm</referencedModelFilename>

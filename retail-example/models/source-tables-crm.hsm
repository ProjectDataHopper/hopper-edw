      <freeSql>SELECT o.order_id, e.message_id
FROM order_header o
INNER JOIN order_shipment_tracking e ON o.order_id = e.order_id</freeSql>
      <generationMode>FREE_SQL</generationMode>
      <xloc>1088</xloc>

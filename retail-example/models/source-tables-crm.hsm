      <description/>
      <drivingTableName>customer_address</drivingTableName>
      <joins/>
      <columns/>
      <dataTypeMappingNames/>
      <fieldTypeMappings/>
      <whereClause/>
      <freeSql>SELECT c.customer_id, a.city
FROM customer_hub c
INNER JOIN customer_address a ON c.customer_id = a.customer_id
WHERE c.customer_id > 0
ORDER BY a.city
LIMIT 100</freeSql>
      <generationMode>FREE_SQL</generationMode>
      <xloc>624</xloc>
      <yloc>176</yloc>
      <name>Calcite Query</name>
    </query>

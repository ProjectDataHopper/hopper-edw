    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jdk8</artifactId>
      <version>2.21.1</version>
    </dependency>
    <!-- Sandboxed Jinja2 for Business Vault SQL / dbt macros (issue #72). -->

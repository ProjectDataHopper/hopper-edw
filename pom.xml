<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.projectdatahopper.hop</groupId>
  <artifactId>hopper-edw</artifactId>
  <version>0.10.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Data Hopper EDW</name>
  <description>Apache Hop plugins to design, generate, and operate an Enterprise Data Warehouse: source models, Data Catalog, Data Vault 2.0, Business Vault, dimensional models, quality, lineage, and the EDW Journey</description>
  <url>https://github.com/ProjectDataHopper/hopper-edw</url>

  <organization>
    <name>i-Bridge bv</name>
    <url>https://data-hopper.com</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>mattcasters</id>
      <name>Matt Casters</name>
      <organization>i-Bridge bv</organization>
      <organizationUrl>https://data-hopper.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/ProjectDataHopper/hopper-edw.git</connection>
    <developerConnection>scm:git:git@github.com:ProjectDataHopper/hopper-edw.git</developerConnection>
    <url>https://github.com/ProjectDataHopper/hopper-edw</url>
  </scm>

  <properties>
    <apache.rat.version>0.16.1</apache.rat.version>
    <!-- 3.x requires Maven 3.8.8+; 2.2.6 works on 3.8.7 (common distro pin). -->
    <asciidoctor.maven.plugin.version>2.2.6</asciidoctor.maven.plugin.version>
    <!-- Apache Calcite for source-model SQL virtualisation (issue #117). -->
    <calcite.version>1.40.0</calcite.version>
    <commonmark.version>0.29.0</commonmark.version>
    <elk.version>0.10.0</elk.version>
    <hadoop.version>3.3.6</hadoop.version>
    <!-- Required runtime: Apache Hop 2.19.0. -->
    <hop.version>2.19.0</hop.version>
    <iceberg.version>1.6.1</iceberg.version>
    <jandex.version>3.5.3</jandex.version>
    <!-- HubSpot Jinjava: dbt-style Jinja for BV SQL (issue #72). Do not drop below 2.8.3. -->
    <jinjava.version>2.8.4</jinjava.version>
    <lombok.version>1.18.42</lombok.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <plantuml.version>1.2025.4</plantuml.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spotless-maven-plugin.version>2.43.0</spotless-maven-plugin.version>
  </properties>

  <dependencies>

    <!-- Compile-time deps normally supplied by Hop at runtime -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.21.1</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>

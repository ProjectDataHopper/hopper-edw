    <dependency>
      <groupId>org.apache.hop</groupId>
      <artifactId>hop-databases-singlestore</artifactId>
      <version>${hop.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.apache.hop</groupId>
      <artifactId>hop-transform-addsequence</artifactId>
      <version>${hop.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    Optional ASF snapshots repository. Hop 2.19.0 is released and resolved from Maven
    Central via hop.version. Keep this block only if a compile dependency still needs a
    SNAPSHOT; it is harmless for released artifacts (releases are disabled).
  -->
  <repositories>
    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </snapshots>
      <id>apache.snapshots</id>
      <name>Apache Snapshot Repository</name>
      <url>https://repository.apache.org/snapshots/</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <classpathDependencyScopeExclude>none</classpathDependencyScopeExclude>
          <!-- Hop defaults audit state to ${user.dir}/audit; keep unit-test noise out of the repo. -->
          <systemPropertyVariables>
            <HOP_AUDIT_FOLDER>/tmp/hopper-edw-audit</HOP_AUDIT_FOLDER>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.12.1</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
          <release>21</release>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- Generate Jandex index (META-INF/jandex.idx) so Hop can efficiently discover
           all plugin annotations (@HopMetadata, @GuiPlugin, @HopFileTypePlugin, etc.)
           without expensive runtime scanning. -->
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <version>${jandex.version}</version>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/**/*.java</include>
              <include>hop-hsm-jdbc/src/**/*.java</include>
            </includes>
            <googleJavaFormat></googleJavaFormat>
            <importOrder></importOrder>
            <removeUnusedImports></removeUnusedImports>
            <licenseHeader>
              <content><![CDATA[/*
 * Copyright 2026 i-Bridge bv
 *
 * Licensed under the Apache License, Version 2.0 (the "License");
 * you may not use this file except in compliance with the License.
 * You may obtain a copy of the License at
 *
 *      http://www.apache.org/licenses/LICENSE-2.0
 *
 * Unless required by applicable law or agreed to in writing, software
 * distributed under the License is distributed on an "AS IS" BASIS,
 * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
 * See the License for the specific language governing permissions and
 * limitations under the License.
 */]]></content>
            </licenseHeader>
          </java>
          <pom>
            <includes>
              <include>pom.xml</include>
            </includes>
            <sortPom>
              <nrOfIndentSpace>2</nrOfIndentSpace>
              <sortProperties>true</sortProperties>
              <sortModules>true</sortModules>
              <sortExecutions>true</sortExecutions>
              <sortDependencies>scope,groupId,artifactId</sortDependencies>
              <sortDependencyExclusions>scope,groupId,artifactId</sortDependencyExclusions>
              <sortDependencyManagement>false</sortDependencyManagement>
            </sortPom>
          </pom>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <version>${apache.rat.version}</version>
        <configuration>
          <consoleOutput>true</consoleOutput>
          <excludes>
            <exclude>LICENSE</exclude>
            <exclude>NOTICE</exclude>
            <exclude>**/target/**</exclude>
            <exclude>**/*.svg</exclude>
            <exclude>**/*.json</exclude>
            <exclude>**/*.hdv</exclude>
            <exclude>**/*.hpl</exclude>
            <exclude>**/*.hwf</exclude>
            <exclude>**/*.hdv</exclude>
            <exclude>**/*.hbv</exclude>
            <exclude>**/*.hdm</exclude>
            <exclude>**/datasets/*.csv</exclude>
            <exclude>**/*.jpg</exclude>
            <exclude>**/*.png</exclude>
            <exclude>**/*.iml</exclude>
            <exclude>.gitignore</exclude>
            <exclude>AGENTS.md</exclude>
            <exclude>docs/**</exclude>
            <exclude>project/**</exclude>
            <exclude>**/prompts/**/*.txt</exclude>
            <exclude>**/requirements.txt</exclude>
            <exclude>**/requirements.txt</exclude>
            <exclude>.gitattributes</exclude>

            <!-- General Exclusions -->
            <exclude>DISCLAIMER</exclude>
            <exclude>LICENSE</exclude>
            <exclude>NOTICE</exclude>
            <exclude>.asf.yaml</exclude>
            <exclude>**/licenses/*</exclude>
            <exclude>**/target/**</exclude>
            <exclude>**/*.svg</exclude>
            <exclude>**/*.json</exclude>
            <exclude>**/hop.pwd</exclude>
            <exclude>**/*.iml</exclude>
            <exclude>.dockerignore</exclude>
            <!-- symlink alias of AGENTS.md (header lives on the target) -->
            <exclude>CLAUDE.md</exclude>

            <!-- Unit Test Exclusions -->
            <exclude>**/src/test/resources/**/*.yml</exclude>
            <exclude>**/src/test/resources/**/*.yaml</exclude>
            <exclude>**/src/test/resources/**/*.sql</exclude>
            <exclude>**/test/**/*.txt</exclude>
            <exclude>**/test/**/*.xml</exclude>
            <exclude>**/test/**/*.xsd</exclude>
            <exclude>**/test/**/*.csv</exclude>
            <exclude>**/test/**/*.csv.bz2</exclude>
            <exclude>**/test/**/*.csv.gz</exclude>
            <exclude>**/test/**/*.ods</exclude>
            <exclude>**/test/**/*.xls</exclude>
            <exclude>**/test/**/*.xlsx</exclude>
            <exclude>**/test/**/*.edi</exclude>
            <exclude>**/test/**/*.avro</exclude>
            <exclude>**/test/**/*.snippet</exclude>

            <!-- Integration Test Exclusion -->
            <exclude>**/datasets/*.csv</exclude>
            <exclude>**/it/**/*.csv</exclude>

            <!-- External Integration Test Exclusion -->
            <exclude>**/integration-tests/**/*.txt</exclude>
            <exclude>**/integration-tests/**/*.md</exclude>
            <exclude>**/integration-tests/**/*.csv</exclude>
            <exclude>**/integration-tests/**/*.avro</exclude>
            <exclude>**/integration-tests/**/*.xls</exclude>
            <exclude>**/integration-tests/**/*.xlsx</exclude>
            <exclude>**/integration-tests/**/*.json</exclude>
            <exclude>**/integration-tests/**/*.json.old</exclude>
            <exclude>**/integration-tests/**/*.edi</exclude>
            <exclude>**/integration-tests/**/db.data</exclude>
            <exclude>**/integration-tests/**/jmxremote.*</exclude>
            <exclude>**/integration-tests/**/jwt_publickey</exclude>
            <exclude>**/integration-tests/**/*.key</exclude>
            <exclude>**/integration-tests/**/*.crt</exclude>
            <exclude>**/integration-tests/**/*.csr</exclude>
            <exclude>**/integration-tests/**/mtls.conf</exclude>
            <!-- Goldens compared byte-for-byte to Hop output (no ASF header; see FILE_COMPARE in xml integration HWFs) -->
            <exclude>**/integration-tests/xml/files/expected/**</exclude>
            <exclude>**/integration-tests/ssh/keys/it_rsa</exclude>
            <exclude>**/integration-tests/ssh/keys/it_rsa.pub</exclude>

            <!-- Samples Exclusions -->
            <!-- plugins/engines/beam -->
            <exclude>**/src/main/samples/**/*.txt</exclude>
            <exclude>**/src/main/samples/**/*.csv</exclude>

            <!-- Documentation Exclusions-->
            <exclude>docs/content/**</exclude>
            <exclude>docs/resources/**</exclude>
            <exclude>docs/node_modules/**</exclude>
            <exclude>docs/.pnp/**</exclude>
            <exclude>docs/.pnp.js</exclude>
            <exclude>docs/yarn.lock</exclude>

            <!-- Hop audit manager output (also redirected under /tmp for surefire) -->
            <exclude>audit/**</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- PlantUML jar is a build tool only — never a project/runtime dependency. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-plantuml</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>net.sourceforge.plantuml</groupId>
                  <artifactId>plantuml</artifactId>
                  <version>${plantuml.version}</version>
                  <outputDirectory>${project.build.directory}/tools</outputDirectory>
                  <destFileName>plantuml.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Render docs/diagrams/*.puml to committed SVGs (Smetana layout; no Graphviz). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>plantuml-docs</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <executable>bash</executable>
              <arguments>
                <argument>-c</argument>
                <argument>shopt -s nullglob; files=("${project.basedir}"/docs/diagrams/*.puml); if [ ${#files[@]} -eq 0 ]; then echo "No PlantUML sources; using committed SVGs"; exit 0; fi; java -Djava.awt.headless=true -jar "${project.build.directory}/tools/plantuml.jar" -tsvg -o "${project.basedir}/docs/images/diagrams" "${files[@]}"</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>build-hop-hsm-jdbc</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <executable>bash</executable>
              <arguments>
                <argument>-c</argument>
                <argument>if [ ! -f "${project.basedir}/hop-hsm-jdbc/pom.xml" ]; then echo "Skipping hop-hsm-jdbc (no module POM)"; exit 0; fi; mvn -q -f "${project.basedir}/hop-hsm-jdbc/pom.xml" package -DskipTests</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- HTML user guide for the plugin zip (plugins/misc/datavault/docs/). -->
      <plugin>
        <groupId>org.asciidoctor</groupId>
        <artifactId>asciidoctor-maven-plugin</artifactId>
        <version>${asciidoctor.maven.plugin.version}</version>
        <executions>
          <execution>
            <id>generate-html-docs</id>
            <goals>
              <goal>process-asciidoc</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <backend>html5</backend>
              <doctype>article</doctype>
              <sourceDirectory>${project.basedir}/docs</sourceDirectory>
              <outputDirectory>${project.build.directory}/generated-docs</outputDirectory>
              <preserveDirectories>true</preserveDirectories>
              <attributes>
                <sectanchors>true</sectanchors>
                <idprefix></idprefix>
                <idseparator>-</idseparator>
                <source-highlighter>coderay</source-highlighter>
              </attributes>
              <resources>
                <resource>
                  <directory>${project.basedir}/docs/images</directory>
                  <targetPath>images</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/docs/diagrams</directory>
                  <targetPath>diagrams</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/docs/presentations</directory>
                  <targetPath>presentations</targetPath>
                  <includes>
                    <include>*.html</include>
                    <include>*.md</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/docs</directory>
                  <includes>
                    <include>hop-web-modelers.md</include>
                    <include>ai-advisory.md</include>
                    <include>performance-tuning.md</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- After Asciidoctor so generated-docs exists. Java only — Jenkins hop-build has no python3. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>rewrite-adoc-hrefs</id>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <target>
                <exec executable="${java.home}/bin/java" failonerror="true">
                  <arg value="-cp"></arg>
                  <arg value="${project.build.outputDirectory}"></arg>
                  <arg value="org.hopper.edw.datavault.docs.RewriteAdocHrefs"></arg>
                  <arg value="${project.build.directory}/generated-docs"></arg>
                </exec>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Assembly to create a plugin distribution zip for easy install -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <descriptors>
            <descriptor>src/assembly/assembly.xml</descriptor>
          </descriptors>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
        <executions>
          <execution>
            <id>make-assembly</id>
            <goals>
              <goal>single</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
